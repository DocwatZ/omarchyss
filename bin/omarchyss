#!/usr/bin/env bash
set -euo pipefail

readonly APP_CLASS="io.github.docwatz.omarchyss"
readonly STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchyss-${UID}"
readonly STATE_FILE="$STATE_DIR/spotify-was-playing"
readonly BRANDING_FILE="${HOME}/.config/omarchy/branding/screensaver.txt"

mkdir -p -m 700 "$STATE_DIR"

have() { command -v "$1" >/dev/null 2>&1; }
spotify_available() { have playerctl && playerctl --player=spotify status >/dev/null 2>&1; }

status() {
  local running=false playback="" track=""
  if have hyprctl && hyprctl clients -j | jq -e --arg class "$APP_CLASS" '.[] | select(.class == $class)' >/dev/null 2>&1; then
    running=true
  fi
  if spotify_available; then
    playback=$(playerctl --player=spotify status 2>/dev/null || true)
    track=$(playerctl --player=spotify metadata --format '{{artist}} — {{title}}' 2>/dev/null || true)
  fi
  jq -nc --argjson running "$running" --arg playback "$playback" --arg track "$track" \
    '{running: $running, playback: $playback, track: $track}'
}

stop() {
  if have hyprctl; then
    hyprctl clients -j | jq -r --arg class "$APP_CLASS" '.[] | select(.class == $class) | .address' |
      while IFS= read -r address; do hyprctl dispatch closewindow "address:$address" >/dev/null; done
  fi
  if [[ -f $STATE_FILE ]] && spotify_available; then playerctl --player=spotify play; fi
  rm -f "$STATE_FILE"
}

media() {
  spotify_available || exit 0
  case "${1:-}" in
    play-pause) playerctl --player=spotify play-pause ;;
    next) playerctl --player=spotify next ;;
    previous) playerctl --player=spotify previous ;;
    *) exit 2 ;;
  esac
}

wait_for_audio_frame() {
  have cava || return 0
  local config fifo cava_pid frame
  config=$(mktemp "${STATE_DIR}/cava.XXXXXX")
  fifo=$(mktemp -u "${STATE_DIR}/cava.XXXXXX")
  mkfifo -m 600 "$fifo"
  cat > "$config" <<EOF
[input]
method = pipewire
source = auto
[output]
method = raw
raw_target = $fifo
data_format = ascii
ascii_max_range = 1000
EOF
  cava -p "$config" >/dev/null 2>&1 &
  cava_pid=$!
  IFS= read -r -t 2 frame < "$fifo" || true
  kill "$cava_pid" 2>/dev/null || true
  wait "$cava_pid" 2>/dev/null || true
  rm -f "$config" "$fifo"
}

start() {
  local effect=random text_mode=track custom_text="" pause_spotify=true timeout=0 beat_reactive=false
  while (($#)); do
    case "$1" in
      --effect|--text-mode|--custom-text|--pause-spotify|--timeout|--beat-reactive)
        [[ $# -ge 2 ]] || exit 2
        case "$1" in
          --effect) effect=$2 ;; --text-mode) text_mode=$2 ;; --custom-text) custom_text=$2 ;;
          --pause-spotify) pause_spotify=$2 ;; --timeout) timeout=$2 ;; --beat-reactive) beat_reactive=$2 ;;
        esac
        shift 2 ;;
      *) exit 2 ;;
    esac
  done
  [[ $effect =~ ^(random|beams|bubbles|fireworks|matrix|rain|rings|spotlights|thunderstorm|waves)$ ]] || exit 2
  [[ $text_mode =~ ^(track|branding|custom)$ && $timeout =~ ^[0-9]+$ ]] || exit 2
  if [[ $(status | jq -r .running) == true ]]; then stop; return; fi
  if [[ $pause_spotify == true ]] && spotify_available && [[ $(playerctl --player=spotify status) == Playing ]]; then
    : > "$STATE_FILE"; playerctl --player=spotify pause
  fi
  local self
  self=$(readlink -f "$0")
  if have alacritty; then
    alacritty --class "$APP_CLASS,$APP_CLASS" --title "OmarchySS" -e bash "$self" run "$effect" "$text_mode" "$custom_text" "$timeout" "$beat_reactive" &
  elif have foot; then
    foot --app-id="$APP_CLASS" --title="OmarchySS" bash "$self" run "$effect" "$text_mode" "$custom_text" "$timeout" "$beat_reactive" &
  else
    printf '%s\n' "OmarchySS requires Alacritty or Foot." >&2
    stop
    exit 1
  fi
}

run() {
  local effect=$1 text_mode=$2 custom_text=$3 timeout=$4 beat_reactive=$5 started=$SECONDS input effect_arg
  local tmp
  tmp=$(mktemp "${STATE_DIR}/text.XXXXXX")
  trap 'rm -f "$tmp"; stop; exit' EXIT INT TERM HUP
  printf '\033]11;rgb:00/00/00\007'
  while :; do
    (( timeout == 0 || SECONDS - started < timeout )) || exit 0
    case "$text_mode" in
      track) spotify_available && playerctl --player=spotify metadata --format '{{artist}}\n{{title}}' > "$tmp" || printf 'OMARCHYSS\n' > "$tmp" ;;
      branding) [[ -f $BRANDING_FILE ]] && cp "$BRANDING_FILE" "$tmp" || printf 'OMARCHYSS\n' > "$tmp" ;;
      custom) printf '%s\n' "$custom_text" > "$tmp" ;;
    esac
    [[ $beat_reactive == true ]] && wait_for_audio_frame
    effect_arg=$effect
    [[ $effect == random ]] && effect_arg=""
    if [[ -n $effect_arg ]]; then
      ttfx -i "$tmp" "$effect_arg" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --no-eol --no-restore-cursor
    else
      ttfx -i "$tmp" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor
    fi
    if [[ $beat_reactive == true ]] && ! have cava; then
      sleep 1
    fi
  done
}

case "${1:-}" in
  start) shift; start "$@" ;;
  stop) stop ;;
  status) status ;;
  media) shift; media "${1:-}" ;;
  run) shift; run "$@" ;;
  *) printf '%s\n' "Usage: omarchyss {start|stop|status|media}" >&2; exit 2 ;;
esac
