#!/usr/bin/env bash
set -euo pipefail

readonly APP_CLASS="io.github.docwatz.omarchyss"
readonly STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchyss-${UID}"
readonly STATE_FILE="$STATE_DIR/spotify-was-playing"
readonly BRANDING_FILE="${HOME}/.config/omarchy/branding/screensaver.txt"

mkdir -p -m 700 "$STATE_DIR"

have() { command -v "$1" >/dev/null 2>&1; }
spotify_available() { have playerctl && playerctl --player=spotify status >/dev/null 2>&1; }

status() {
  local running=false playback="" track=""
  if have hyprctl && hyprctl clients -j | jq -e --arg class "$APP_CLASS" '.[] | select(.class == $class)' >/dev/null 2>&1; then
    running=true
  fi
  if spotify_available; then
    playback=$(playerctl --player=spotify status 2>/dev/null || true)
    track=$(playerctl --player=spotify metadata --format '{{artist}} — {{title}}' 2>/dev/null || true)
  fi
  jq -nc --argjson running "$running" --arg playback "$playback" --arg track "$track" \
    '{running: $running, playback: $playback, track: $track}'
}

stop() {
  if have hyprctl; then
    hyprctl clients -j | jq -r --arg class "$APP_CLASS" '.[] | select(.class == $class) | .address' |
      while IFS= read -r address; do hyprctl dispatch closewindow "address:$address" >/dev/null; done
  fi
  if [[ -f $STATE_FILE ]] && spotify_available; then playerctl --player=spotify play; fi
  rm -f "$STATE_FILE"
}

media() {
  spotify_available || exit 0
  case "${1:-}" in
    play-pause) playerctl --player=spotify play-pause ;;
    next) playerctl --player=spotify next ;;
    previous) playerctl --player=spotify previous ;;
    *) exit 2 ;;
  esac
}

figlet_available() { have figlet; }

render_text() {
  # Renders $1 (raw text, possibly multi-line) into $tmp, using FIGlet when
  # requested and available, otherwise writing the plain text unchanged.
  local raw=$1
  if [[ $USE_FIGLET == true ]] && [[ -n $FIGLET_FONT_PATH ]] && [[ -f $FIGLET_FONT_PATH ]] && figlet_available; then
    printf '%s\n' "$raw" | figlet -f "$FIGLET_FONT_PATH" -w 400 > "$RUN_TMP" || printf '%s\n' "$raw" > "$RUN_TMP"
  else
    printf '%s\n' "$raw" > "$RUN_TMP"
  fi
}

wait_for_audio_frame() {
  have cava || return 0
  local config fifo cava_pid frame
  config=$(mktemp "${STATE_DIR}/cava.XXXXXX")
  fifo=$(mktemp -u "${STATE_DIR}/cava.XXXXXX")
  mkfifo -m 600 "$fifo"
  cat > "$config" <<EOF
[input]
method = pipewire
source = auto
[output]
method = raw
raw_target = $fifo
data_format = ascii
ascii_max_range = 1000
EOF
  cava -p "$config" >/dev/null 2>&1 &
  cava_pid=$!
  IFS= read -r -t 2 frame < "$fifo" || true
  kill "$cava_pid" 2>/dev/null || true
  wait "$cava_pid" 2>/dev/null || true
  rm -f "$config" "$fifo"
}

start() {
  local effect=random text_mode=track custom_text="" pause_spotify=true timeout=0 beat_reactive=false font_size=28
  local use_figlet=false figlet_font=""
  while (($#)); do
    case "$1" in
      --effect|--text-mode|--custom-text|--pause-spotify|--timeout|--beat-reactive|--font-size|--use-figlet|--figlet-font)
        [[ $# -ge 2 ]] || exit 2
        case "$1" in
          --effect) effect=$2 ;; --text-mode) text_mode=$2 ;; --custom-text) custom_text=$2 ;;
          --pause-spotify) pause_spotify=$2 ;; --timeout) timeout=$2 ;; --beat-reactive) beat_reactive=$2 ;;
          --font-size) font_size=$2 ;; --use-figlet) use_figlet=$2 ;; --figlet-font) figlet_font=$2 ;;
        esac
        shift 2 ;;
      *) exit 2 ;;
    esac
  done
  [[ $effect =~ ^(random|beams|bubbles|fireworks|matrix|rain|rings|spotlights|thunderstorm|waves)$ ]] || exit 2
  if ! [[ $text_mode =~ ^(track|branding|custom)$ && $timeout =~ ^[0-9]+$ && $font_size =~ ^[0-9]+$ && $font_size -ge 6 && $font_size -le 72 ]]; then
    echo "omarchyss: invalid start arguments (text-mode=$text_mode timeout=$timeout font-size=$font_size, must be 6-72)" >&2
    exit 2
  fi
  if [[ $(status | jq -r .running) == true ]]; then stop; return; fi
  if [[ $pause_spotify == true ]] && spotify_available && [[ $(playerctl --player=spotify status) == Playing ]]; then
    : > "$STATE_FILE"; playerctl --player=spotify pause
  fi
  local self
  self=$(readlink -f "$0")
  if have alacritty; then
    alacritty --class "$APP_CLASS,$APP_CLASS" --title "OmarchySS" --option "font.size=$font_size" -e bash "$self" run "$effect" "$text_mode" "$custom_text" "$timeout" "$beat_reactive" "$use_figlet" "$figlet_font" &
  elif have foot; then
    # foot has no standalone font-size key; override the whole font list with a
    # generic monospace fallback at the requested size. This may not match the
    # user's usual terminal font family when Alacritty is unavailable.
    foot --app-id="$APP_CLASS" --title="OmarchySS" --override="font=monospace:size=$font_size" bash "$self" run "$effect" "$text_mode" "$custom_text" "$timeout" "$beat_reactive" "$use_figlet" "$figlet_font" &
  else
    printf '%s\n' "OmarchySS requires Alacritty or Foot." >&2
    stop
    exit 1
  fi
}

# Populated by run() before the EXIT trap is registered. It is intentionally a
# global (not a function-local) so the trap can still clean it up after
# `set -e` unwinds the whole script on a failing command -- traps run in the
# top-level scope, where function-local variables are no longer visible.
RUN_TMP=""

run() {
  local effect=$1 text_mode=$2 custom_text=$3 timeout=$4 beat_reactive=$5
  USE_FIGLET=${6:-false}
  FIGLET_FONT_PATH=${7:-}
  local started=$SECONDS effect_arg raw_text
  RUN_TMP=$(mktemp "${STATE_DIR}/text.XXXXXX")
  trap 'rm -f "${RUN_TMP:-}"; stop; exit' EXIT INT TERM HUP
  printf '\033]11;rgb:00/00/00\007'
  while :; do
    (( timeout == 0 || SECONDS - started < timeout )) || exit 0
    case "$text_mode" in
      track)
        if spotify_available; then
          raw_text=$(playerctl --player=spotify metadata --format '{{artist}}
{{title}}')
        else
          raw_text="OMARCHYSS"
        fi
        ;;
      branding) raw_text=$([[ -f $BRANDING_FILE ]] && cat "$BRANDING_FILE" || printf 'OMARCHYSS') ;;
      custom) raw_text=$custom_text ;;
    esac
    render_text "$raw_text"
    [[ $beat_reactive == true ]] && wait_for_audio_frame
    effect_arg=$effect
    [[ $effect == random ]] && effect_arg=""
    # ttfx's global rendering options must precede the effect subcommand; the
    # subcommand only accepts its own effect-specific flags after it.
    if [[ -n $effect_arg ]]; then
      ttfx -i "$RUN_TMP" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --no-eol --no-restore-cursor "$effect_arg"
    else
      ttfx -i "$RUN_TMP" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor
    fi
    if [[ $beat_reactive == true ]] && ! have cava; then
      sleep 1
    fi
  done
}

case "${1:-}" in
  start) shift; start "$@" ;;
  stop) stop ;;
  status) status ;;
  media) shift; media "${1:-}" ;;
  run) shift; run "$@" ;;
  *) printf '%s\n' "Usage: omarchyss {start|stop|status|media}" >&2; exit 2 ;;
esac
