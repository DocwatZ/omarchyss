#!/usr/bin/env bash
set -euo pipefail

readonly APP_CLASS="io.github.docwatz.omarchyss"
readonly PLUGIN_DIR="$(dirname "$(dirname "$(readlink -f "$0")")")"
readonly MANIFEST="${PLUGIN_DIR}/manifest.json"
readonly SHELL_JSON="${HOME}/.config/omarchy/shell.json"
readonly STATE_ROOT="${XDG_RUNTIME_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}}"
readonly STATE_DIR="${STATE_ROOT}/omarchyss-${UID}"
readonly STATE_FILE="$STATE_DIR/spotify-was-playing"
readonly ALACRITTY_SOCKET_PATH="$STATE_DIR/alacritty.sock"
readonly BRANDING_FILE="${HOME}/.config/omarchy/branding/screensaver.txt"
readonly BRANDING_DEFAULT_FILE="${PLUGIN_DIR}/assets/screensaver.txt"
readonly FONT_FAMILY="Omarchy Font"
readonly FONT_SOURCE="${PLUGIN_DIR}/assets/fonts/Omarchy Font.ttf"
readonly FONT_INSTALL_DIR="${HOME}/.local/share/fonts/omarchyss"
readonly FONT_INSTALL_FILE="${FONT_INSTALL_DIR}/Omarchy Font.ttf"
readonly SPOTIFY_HELPER="$(dirname "$(readlink -f "$0")")/omarchyss-spotify"

umask 077
mkdir -p "$STATE_DIR"
[[ -d $STATE_DIR && ! -L $STATE_DIR ]] || {
  printf '%s\n' "OmarchySS: runtime state path is not a directory: $STATE_DIR" >&2
  exit 1
}
chmod 700 "$STATE_DIR"

have() { command -v "$1" >/dev/null 2>&1; }

ensure_font_installed() {
  [[ -f $FONT_SOURCE ]] || {
    printf '%s\n' "OmarchySS: bundled font is missing: $FONT_SOURCE" >&2
    return 1
  }
  if [[ -f $FONT_INSTALL_FILE ]] && cmp -s "$FONT_SOURCE" "$FONT_INSTALL_FILE"; then
    return
  fi
  have fc-cache || {
    printf '%s\n' "OmarchySS requires fc-cache to install its bundled font." >&2
    return 1
  }
  mkdir -p "$FONT_INSTALL_DIR"
  install -m 0644 "$FONT_SOURCE" "$FONT_INSTALL_FILE"
  fc-cache -f "$FONT_INSTALL_DIR" >/dev/null
}

# Reads a bar widget setting, preferring the value configured on the bar
# (~/.config/omarchy/shell.json), then the plugin manifest's default, then the
# supplied fallback. This keeps the terminal command in sync with whatever was
# set through `omarchy bar set` or the bar widget itself.
resolve_setting() {
  local key=$1 fallback=$2 value=""
  if [[ -f $SHELL_JSON ]] && have jq; then
    value=$(jq -r --arg id "$APP_CLASS" --arg key "$key" '
      [.bar.layout.left[]?, .bar.layout.center[]?, .bar.layout.right[]?]
      | map(select(.id == $id)) | .[0][$key]? // empty
    ' "$SHELL_JSON" 2>/dev/null || true)
  fi
  if [[ -z $value && -f $MANIFEST ]] && have jq; then
    value=$(jq -r --arg key "$key" '.barWidget.defaults[$key]? // empty' "$MANIFEST" 2>/dev/null || true)
  fi
  printf '%s' "${value:-$fallback}"
}

# Starts (or toggles off) the screensaver using the settings configured on the
# bar, so `omarchyss` from a terminal behaves exactly like clicking the widget.
# Any flags passed through override the resolved values.
start_from_settings() {
  start \
    --effect "$(resolve_setting effect random)" \
    --text-mode "$(resolve_setting textMode track)" \
    --custom-text "$(resolve_setting customText '')" \
    --pause-spotify "$(resolve_setting pauseSpotify true)" \
    --timeout "$(resolve_setting autoCloseSeconds 0)" \
    --beat-reactive "$(resolve_setting beatReactive false)" \
    --beat-sensitivity "$(resolve_setting beatSensitivity medium)" \
    --font-size "$(resolve_setting fontSize 28)" \
    --use-figlet "$(resolve_setting useFiglet false)" \
    --figlet-font "$(resolve_setting figletFontPath '')" \
    "$@"
}

# Puts `omarchyss` on PATH. Plugins are plain git clones with no install hook,
# so this is run once by hand after `omarchy plugin add` (see the README).
install_command() {
  local target=${1:-$HOME/.local/bin} self
  self=$(readlink -f "$0")
  ensure_font_installed
  mkdir -p "$target"
  ln -sfn "$self" "$target/omarchyss"
  printf '%s\n' "Installed $target/omarchyss -> $self"
  printf '%s\n' "Installed $FONT_INSTALL_FILE"
  case ":${PATH}:" in
    *":${target}:"*) ;;
    *) printf '%s\n' "Note: $target is not on your PATH; add it to your shell profile." >&2 ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: omarchyss [command]

  (no command)    Toggle the screensaver using your bar widget settings
  start [flags]   Start (or toggle off) with explicit settings
  stop            Stop a running screensaver
  restart         Restart, picking up current settings
  status          Print screensaver/playback status as JSON
  media <action>  play-pause | next | previous
  install [dir]   Symlink this script onto PATH (default: ~/.local/bin)
EOF
}

spotify_player() {
  have playerctl || return 1
  local player state spotifyd_player="" spotify_player_name=""
  while IFS= read -r player; do
    state=$(playerctl --player="$player" status 2>/dev/null || true)
    [[ $state == Playing && $player == spotifyd* ]] && { printf '%s' "$player"; return; }
    [[ $state == Playing && $player == spotify ]] && spotify_player_name=$player
    [[ $player == spotifyd* ]] && spotifyd_player=$player
    [[ $player == spotify ]] && spotify_player_name=$player
  done < <(playerctl -l 2>/dev/null)
  [[ -n $spotifyd_player ]] && { printf '%s' "$spotifyd_player"; return; }
  [[ -n $spotify_player_name ]] && printf '%s' "$spotify_player_name"
}

spotifyctl() {
  local player
  player=$(spotify_player) || return 1
  playerctl --player="$player" "$@"
}

spotify_cloud_json() {
  [[ -x $SPOTIFY_HELPER ]] && python3 "$SPOTIFY_HELPER" now-playing 2>/dev/null
}

spotify_status() {
  local cloud
  cloud=$(spotify_cloud_json || true)
  if [[ -n $cloud ]] && jq -e '.active == true' >/dev/null 2>&1 <<< "$cloud"; then
    [[ $(jq -r '.isPlaying' <<< "$cloud") == true ]] && printf 'Playing' || printf 'Paused'
  else
    spotifyctl status 2>/dev/null
  fi
}

spotify_track() {
  local cloud
  cloud=$(spotify_cloud_json || true)
  if [[ -n $cloud ]] && jq -e '.active == true' >/dev/null 2>&1 <<< "$cloud"; then
    jq -r '[.artists, .title] | map(select(length > 0)) | join(" — ")' <<< "$cloud"
  else
    spotifyctl metadata --format '{{artist}} — {{title}}' 2>/dev/null
  fi
}

spotify_action() {
  local action=$1
  if [[ -x $SPOTIFY_HELPER ]] && python3 "$SPOTIFY_HELPER" control "$action" >/dev/null 2>&1; then
    return
  fi
  spotifyctl "$action"
}

spotify_available() { [[ -n $(spotify_status || true) ]]; }

screensaver_running() {
  have hyprctl && hyprctl clients -j |
    jq -e --arg class "$APP_CLASS" '.[] | select(.class == $class)' >/dev/null 2>&1
}

status() {
  local running=false playback="" track="" cloud
  if screensaver_running; then
    running=true
  fi
  cloud=$(spotify_cloud_json || true)
  if [[ -n $cloud ]] && jq -e '.active == true' >/dev/null 2>&1 <<< "$cloud"; then
    [[ $(jq -r '.isPlaying' <<< "$cloud") == true ]] && playback=Playing || playback=Paused
    track=$(jq -r '[.artists, .title] | map(select(length > 0)) | join(" — ")' <<< "$cloud")
  elif spotify_available; then
    playback=$(spotifyctl status 2>/dev/null || true)
    track=$(spotifyctl metadata --format '{{artist}} — {{title}}' 2>/dev/null || true)
  fi
  jq -nc --argjson running "$running" --arg playback "$playback" --arg track "$track" \
    '{running: $running, playback: $playback, track: $track}'
}

stop() {
  if have hyprctl; then
    local pid
    while IFS= read -r pid; do
      [[ $pid =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null || true
    done < <(hyprctl clients -j | jq -r --arg class "$APP_CLASS" '.[] | select(.class == $class) | .pid')
  fi
  if [[ -f $STATE_FILE ]] && spotify_available; then spotify_action play || true; fi
  rm -f "$STATE_FILE"
}

media() {
  spotify_available || exit 0
  case "${1:-}" in
    play-pause) spotify_action play-pause ;;
    next) spotify_action next ;;
    previous) spotify_action previous ;;
    *) exit 2 ;;
  esac
}

figlet_available() { have figlet; }

# Resolves a configured FIGlet font into the value to pass to `figlet -f`.
# Accepts either a name FIGlet already knows (standard, big, slant, ... from
# figlet's own font directory) or a path to a local .flf file, so a stock
# install gets working FIGlet art without needing to source a font first.
# Falls back to figlet's packaged `standard` font when the selected local path
# no longer exists. That keeps settings copied from another machine usable.
resolve_figlet_font() {
  local font=$1
  [[ -n $font ]] || return 1
  figlet_available || return 1
  [[ $font == "~/"* ]] && font="${HOME}/${font:2}"
  if [[ -f $font ]]; then
    printf '%s' "$font"
    return 0
  fi
  if figlet -f "$font" "A" >/dev/null 2>&1; then
    printf '%s' "$font"
    return 0
  fi
  printf '%s\n' "OmarchySS: FIGlet font '$1' not found; using the standard font instead." >&2
  printf '%s' "standard"
}

# Resolves the text that should currently be shown, for the given text mode.
# Shared by start() (to size the window before it opens) and run() (on every
# refresh of the loop, since the Spotify track can change mid-screensaver).
determine_text() {
  local text_mode=$1 custom_text=$2
  case "$text_mode" in
    track)
      local cloud
      cloud=$(spotify_cloud_json || true)
      if [[ -n $cloud ]] && jq -e '.active == true' >/dev/null 2>&1 <<< "$cloud"; then
        jq -r '[.title, .artists] | map(select(length > 0)) | join(" - ")' <<< "$cloud"
      elif spotify_available; then
        spotifyctl metadata --format '{{title}} - {{artist}}'
      else
        printf 'OMARCHYSS'
      fi
      ;;
    branding)
      if [[ -s $BRANDING_FILE ]]; then
        cat "$BRANDING_FILE"
      elif [[ -s $BRANDING_DEFAULT_FILE ]]; then
        cat "$BRANDING_DEFAULT_FILE"
      else
        printf 'OMARCHYSS'
      fi
      ;;
    custom) printf '%s' "$custom_text" ;;
  esac
}

# Truncates $1 (a single line of plain text, with a trailing "…" once
# shortened) until its own FIGlet rendering is no wider than $3 columns using
# font $2. Used instead of FIGlet's built-in -w wrapping, which breaks a
# single word across multiple stacked lines rather than shrinking it.
fit_line() {
  local line=$1 font=$2 cols=$3 width shortened
  while [[ -n $line ]]; do
    width=$(printf '%s\n' "$line" | figlet -f "$font" -w 2000 2>/dev/null | awk '{ print length }' | sort -n | tail -1)
    (( ${width:-0} <= cols )) && { printf '%s' "$line"; return; }
    shortened=${line:0:${#line}-2}
    if [[ -n $shortened ]]; then
      line="${shortened}…"
    else
      line=""
    fi
  done
  printf '%s' "$1"
}

# Renders $1 (raw text, possibly multi-line -- e.g. artist + title) as FIGlet
# art using font $2, first shrinking each source line so it fits within $3
# columns, then dropping trailing lines so the total stacked height fits
# within $4 rows. This guarantees the art always fits centered inside
# whatever size window it happens to be shown in, instead of FIGlet's default
# per-character line-wrapping (which looks broken for single words).
fit_and_render() {
  local raw=$1 font=$2 cols=$3 lines=$4
  local -a src_lines fitted
  mapfile -t src_lines <<< "$raw"
  local per_line_height
  per_line_height=$(figlet -f "$font" -w 2000 "A" 2>/dev/null | wc -l)
  (( per_line_height < 1 )) && per_line_height=1
  while (( ${#src_lines[@]} > 1 )) && (( ${#src_lines[@]} * per_line_height > lines )); do
    src_lines=("${src_lines[@]:0:${#src_lines[@]}-1}")
  done
  local i
  for i in "${!src_lines[@]}"; do
    fitted[i]=$(fit_line "${src_lines[$i]}" "$font" "$cols")
  done
  printf '%s\n' "${fitted[@]}" | figlet -f "$font" -w 2000 2>/dev/null
}

# Reads the terminal's current column/row count, waiting for two
# consecutive matching readings (or a short timeout) before returning. A
# resize -- whether from the compositor's window rule, the user dragging an
# edge, or our own `alacritty msg config` font-size change below -- can take
# a moment to land, so `tput cols`/`tput lines` may briefly report a stale
# size immediately after one of those events.
read_settled_size() {
  local settle_cols="" settle_lines="" new_cols new_lines tries=0
  while (( tries < 20 )); do
    new_cols=$(tput cols 2>/dev/null || echo 80)
    new_lines=$(tput lines 2>/dev/null || echo 24)
    if [[ $new_cols == "$settle_cols" && $new_lines == "$settle_lines" ]]; then
      break
    fi
    settle_cols=$new_cols
    settle_lines=$new_lines
    tries=$((tries + 1))
    sleep 0.05
  done
  printf '%s %s' "$settle_cols" "$settle_lines"
}

# Targets the Alacritty process that owns this PTY. `alacritty msg` otherwise
# chooses a socket implicitly; with multiple Alacritty processes it can report
# success without changing this screensaver window.
alacritty_set_font_size() {
  local size=$1
  [[ -S ${ALACRITTY_SOCKET:-} ]] || return 1
  alacritty msg -s "$ALACRITTY_SOCKET" config \
    -w "$ALACRITTY_WINDOW_ID" "font.size=$size" >/dev/null 2>&1
}

# Picks the largest Alacritty font size (up to $3, the user-configured
# maximum) that fits the rendered content in the terminal's actual cell grid.
# Testing the real rows/columns is important for Omarchy Font: its metrics do
# not scale like the old monospace font closely enough for a one-shot linear
# estimate.
#
# Foot has no equivalent runtime IPC for changing font size, so on foot this
# is a no-op that just reports the current (fixed-font-size) terminal size;
# fit_and_render()'s own text-truncation fallback is what keeps foot's
# output from overflowing in that case.
fit_font_size_to_window() {
  local raw=$1 font=$2 max_size=$3
  if [[ -z ${ALACRITTY_WINDOW_ID:-} ]] || ! have alacritty; then
    read_settled_size
    return
  fi

  local nat_cols nat_lines size cols lines usable_cols usable_lines next_size
  if [[ $USE_FIGLET == true ]] && [[ -n $font ]] && figlet_available; then
    nat_cols=$(printf '%s\n' "$raw" | figlet -f "$font" -w 2000 2>/dev/null | awk '{ print length }' | sort -n | tail -1)
    nat_lines=$(printf '%s\n' "$raw" | figlet -f "$font" -w 2000 2>/dev/null | wc -l)
  else
    nat_cols=0
    nat_lines=0
    local line
    while IFS= read -r line || [[ -n $line ]]; do
      (( ${#line} > nat_cols )) && nat_cols=${#line}
      nat_lines=$((nat_lines + 1))
    done <<< "$raw"
  fi
  (( ${nat_cols:-0} < 1 )) && nat_cols=1
  (( ${nat_lines:-0} < 1 )) && nat_lines=1

  read -r cols lines <<< "$(read_settled_size)"
  size=$max_size
  while :; do
    alacritty_set_font_size "$size" || break
    read -r cols lines <<< "$(read_settled_size)"
    usable_cols=$((cols * 90 / 100))
    usable_lines=$((lines * 90 / 100))
    (( usable_cols < 1 )) && usable_cols=1
    (( usable_lines < 1 )) && usable_lines=1
    if (( nat_cols <= usable_cols && nat_lines <= usable_lines )) || (( size <= 6 )); then
      break
    fi
    next_size=$((size * usable_cols / nat_cols))
    (( size * usable_lines / nat_lines < next_size )) && next_size=$((size * usable_lines / nat_lines))
    (( next_size >= size )) && next_size=$((size - 1))
    (( next_size < 6 )) && next_size=6
    size=$next_size
  done
  printf '%s %s' "$cols" "$lines"
}

render_text() {
  # Renders $1 (raw text, possibly multi-line) into $RUN_TMP, using FIGlet
  # when requested and available, otherwise writing the plain text unchanged.
  # ttfx auto-sizes its canvas to the real terminal and centers via
  # --anchor-canvas c --anchor-text c, so fitting the content here (rather
  # than letting FIGlet wrap it) is what keeps it centered and unclipped.
  local raw=$1
  local cols lines
  read -r cols lines <<< "$(fit_font_size_to_window "$raw" "$FIGLET_FONT_PATH" "$FONT_SIZE_MAX")"
  if [[ $USE_FIGLET == true ]] && [[ -n $FIGLET_FONT_PATH ]] && figlet_available; then
    local rendered
    cols=$(( cols > 4 ? cols - 2 : cols ))
    lines=$(( lines > 2 ? lines - 2 : lines ))
    rendered=$(fit_and_render "$raw" "$FIGLET_FONT_PATH" "$cols" "$lines")
    if [[ -n $rendered ]]; then
      printf '%s\n' "$rendered" > "$RUN_TMP"
    else
      printf '%s\n' "$raw" > "$RUN_TMP"
    fi
  else
    printf '%s\n' "$raw" > "$RUN_TMP"
  fi
}

terminal_size() {
  printf '%s %s' "$(tput cols 2>/dev/null || echo 80)" "$(tput lines 2>/dev/null || echo 24)"
}

screensaver_pixel_size() {
  if ! have hyprctl || ! have jq; then
    printf '0 0'
    return
  fi
  hyprctl clients -j 2>/dev/null | jq -r --arg class "$APP_CLASS" '
    first(.[] | select(.class == $class) | .size) // [0, 0] | "\(.[0]) \(.[1])"
  ' 2>/dev/null || printf '0 0'
}

LAST_TERMINAL_SIZE=""
LAST_PIXEL_SIZE=""
ALACRITTY_SOCKET=""

remember_viewport() {
  LAST_TERMINAL_SIZE=$(terminal_size)
  LAST_PIXEL_SIZE=$(screensaver_pixel_size)
}

# Return 0 when the terminal grid changed, and 2 when the containing window's
# pixel dimensions changed too. Ctrl+/- changes only the grid; dragging or
# tiling the window changes both. Callers use that distinction to preserve a
# manual zoom while still auto-fitting after a real window resize.
viewport_change_kind() {
  local terminal_now pixel_now
  terminal_now=$(terminal_size)
  [[ $terminal_now != "$LAST_TERMINAL_SIZE" ]] || return 1

  # A pixel resize always changes the grid too, so avoid the comparatively
  # expensive hyprctl query until the cheap PTY dimensions have changed.
  pixel_now=$(screensaver_pixel_size)
  LAST_TERMINAL_SIZE=$terminal_now
  if [[ $pixel_now == "0 0" ]]; then
    # Foot has no runtime font-size IPC, and without compositor geometry a
    # grid change cannot be classified as manual zoom versus window resize.
    # Rerendering is safe in both cases and keeps FIGlet fitting/centering
    # correct.
    return 2
  fi
  if [[ $pixel_now != "$LAST_PIXEL_SIZE" ]]; then
    LAST_PIXEL_SIZE=$pixel_now
    return 2
  fi
  return 0
}

BEAT_CONFIG=""
BEAT_PID=""
BEAT_FD=""
BEAT_WRITE_FD=""
BEAT_BASELINE=0
BEAT_HAVE_BASELINE=false
BEAT_FRAMES=0
BEAT_COOLDOWN=0
BEAT_THRESHOLD_PERCENT=125
BEAT_COOLDOWN_FRAMES=6

start_beat_detector() {
  have cava || return 1
  BEAT_CONFIG=$(mktemp "${STATE_DIR}/cava.XXXXXX")
  cat > "$BEAT_CONFIG" <<EOF
[general]
bars = 16
framerate = 30

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10
EOF
  coproc BEAT_CAVA { exec cava -p "$BEAT_CONFIG" 2>/dev/null; }
  BEAT_PID=$BEAT_CAVA_PID
  BEAT_FD=${BEAT_CAVA[0]}
  BEAT_WRITE_FD=${BEAT_CAVA[1]}
  BEAT_BASELINE=0
  BEAT_HAVE_BASELINE=false
  BEAT_FRAMES=0
  BEAT_COOLDOWN=0
  local first_frame
  if ! IFS= read -r -t 2 -u "$BEAT_FD" first_frame; then
    stop_beat_detector
    return 1
  fi
  audio_frame_is_beat "$first_frame" || true
}

stop_beat_detector() {
  if [[ -n $BEAT_PID ]]; then
    kill "$BEAT_PID" 2>/dev/null || true
    wait "$BEAT_PID" 2>/dev/null || true
  fi
  [[ -n $BEAT_FD ]] && exec {BEAT_FD}<&- || true
  [[ -n $BEAT_WRITE_FD ]] && exec {BEAT_WRITE_FD}>&- || true
  [[ -n $BEAT_CONFIG ]] && rm -f "$BEAT_CONFIG"
  BEAT_CONFIG=""
  BEAT_PID=""
  BEAT_FD=""
  BEAT_WRITE_FD=""
}

audio_frame_is_beat() {
  local frame=$1 value energy=0 count=0 is_beat=false
  local -a bars
  IFS=';' read -ra bars <<< "$frame"

  # Cava orders bars from low to high frequencies. Bass energy gives a much
  # cleaner beat signal than averaging the entire spectrum, especially for
  # vocals and sustained instruments.
  for value in "${bars[@]:0:6}"; do
    [[ $value =~ ^[0-9]+$ ]] || continue
    energy=$((energy + value))
    count=$((count + 1))
  done
  (( count > 0 )) || return 1
  energy=$((energy / count))

  # Compare against the baseline before folding in the current frame, so the
  # transient does not raise its own threshold.
  if [[ $BEAT_HAVE_BASELINE == true ]] \
      && (( BEAT_FRAMES >= 15 && energy >= 40 && energy * 100 >= BEAT_BASELINE * BEAT_THRESHOLD_PERCENT )) \
      && (( BEAT_COOLDOWN == 0 )); then
    is_beat=true
  fi

  if [[ $BEAT_HAVE_BASELINE == false ]]; then
    BEAT_BASELINE=$energy
    BEAT_HAVE_BASELINE=true
  else
    BEAT_BASELINE=$(( (BEAT_BASELINE * 15 + energy) / 16 ))
  fi
  BEAT_FRAMES=$((BEAT_FRAMES + 1))

  if (( BEAT_COOLDOWN > 0 )); then
    BEAT_COOLDOWN=$((BEAT_COOLDOWN - 1))
  fi

  # A six-frame cooldown caps effect changes at five per second while still
  # following quick drum patterns.
  if [[ $is_beat == true ]]; then
    BEAT_COOLDOWN=$BEAT_COOLDOWN_FRAMES
    return 0
  fi
  return 1
}

wait_for_beat_frame() {
  local frame frames=0
  [[ -n $BEAT_FD ]] || return 2
  while (( frames < 30 )); do
    kill -0 "$RUN_EFFECT_PID" 2>/dev/null || return 1
    if ! IFS= read -r -t 1 -u "$BEAT_FD" frame; then
      kill -0 "$BEAT_PID" 2>/dev/null || return 2
      return 1
    fi
    frames=$((frames + 1))
    audio_frame_is_beat "$frame" && return 0
  done
  return 1
}

drain_audio_frames() {
  local frame frames=0
  [[ -n $BEAT_FD ]] || return 0
  while (( frames < 60 )) && IFS= read -r -t 0.01 -u "$BEAT_FD" frame; do
    audio_frame_is_beat "$frame" || true
    frames=$((frames + 1))
  done
}

start() {
  local effect=random text_mode=track custom_text="" pause_spotify=true timeout=0 beat_reactive=false beat_sensitivity=medium font_size=28
  local use_figlet=false figlet_font=""
  while (($#)); do
    case "$1" in
      --effect|--text-mode|--custom-text|--pause-spotify|--timeout|--beat-reactive|--beat-sensitivity|--font-size|--use-figlet|--figlet-font)
        [[ $# -ge 2 ]] || exit 2
        case "$1" in
          --effect) effect=$2 ;; --text-mode) text_mode=$2 ;; --custom-text) custom_text=$2 ;;
          --pause-spotify) pause_spotify=$2 ;; --timeout) timeout=$2 ;; --beat-reactive) beat_reactive=$2 ;;
          --beat-sensitivity) beat_sensitivity=$2 ;;
          --font-size) font_size=$2 ;; --use-figlet) use_figlet=$2 ;; --figlet-font) figlet_font=$2 ;;
        esac
        shift 2 ;;
      *) exit 2 ;;
    esac
  done
  [[ $effect =~ ^(random|beams|bubbles|fireworks|matrix|rain|rings|spotlights|thunderstorm|waves)$ ]] || exit 2
  if ! [[ $text_mode =~ ^(track|branding|custom)$ && $beat_sensitivity =~ ^(low|medium|high)$ && $timeout =~ ^[0-9]+$ && $font_size =~ ^[0-9]+$ && $font_size -ge 6 && $font_size -le 72 ]]; then
    echo "omarchyss: invalid start arguments (text-mode=$text_mode timeout=$timeout font-size=$font_size, must be 6-72)" >&2
    exit 2
  fi
  if screensaver_running; then stop; return; fi
  if [[ $pause_spotify == true && $beat_reactive != true ]] && spotify_available && [[ $(spotify_status) == Playing ]]; then
    : > "$STATE_FILE"; spotify_action pause
  fi
  ensure_font_installed
  local self
  self=$(readlink -f "$0")
  # `font_size` here is just the initial/preferred value: run()'s render
  # loop (via fit_font_size_to_window) live-adjusts Alacritty's actual font
  # size every refresh so the FIGlet text always scales to fit whatever
  # window it's shown in -- a companion Hyprland window rule floats this
  # window (see the plugin README) but no longer needs to fix its size,
  # since the text now adapts to the window instead of the other way round.
  if have alacritty; then
    rm -f -- "$ALACRITTY_SOCKET_PATH"
    alacritty --class "$APP_CLASS,$APP_CLASS" --title "OmarchySS" \
      --socket "$ALACRITTY_SOCKET_PATH" \
      --option "font.normal.family='$FONT_FAMILY'" \
      --option "font.bold.family='$FONT_FAMILY'" \
      --option "font.italic.family='$FONT_FAMILY'" \
      --option "font.bold_italic.family='$FONT_FAMILY'" \
      --option "font.size=$font_size" \
      -e bash "$self" run "$effect" "$text_mode" "$custom_text" "$timeout" "$beat_reactive" "$use_figlet" "$figlet_font" "$font_size" "$beat_sensitivity" &
  elif have foot; then
    foot --app-id="$APP_CLASS" --title="OmarchySS" --override="font=$FONT_FAMILY:size=$font_size" \
      bash "$self" run "$effect" "$text_mode" "$custom_text" "$timeout" "$beat_reactive" "$use_figlet" "$figlet_font" "$font_size" "$beat_sensitivity" &
  else
    printf '%s\n' "OmarchySS requires Alacritty or Foot." >&2
    stop
    exit 1
  fi
}

restart() {
  stop
  local attempt
  for attempt in {1..20}; do
    screensaver_running || break
    sleep 0.05
  done
  ! screensaver_running || {
    printf '%s\n' "OmarchySS could not close the existing window." >&2
    return 1
  }
  if (($#)); then
    start "$@"
  else
    start_from_settings
  fi
}

# Populated by run() before the EXIT trap is registered. It is intentionally a
# global (not a function-local) so the trap can still clean it up after
# `set -e` unwinds the whole script on a failing command -- traps run in the
# top-level scope, where function-local variables are no longer visible.
RUN_TMP=""
RUN_EFFECT_PID=""

cleanup_run() {
  [[ -n $RUN_EFFECT_PID ]] && kill "$RUN_EFFECT_PID" 2>/dev/null || true
  stop_beat_detector
  rm -f "${RUN_TMP:-}"
  stop || true
  return 0
}

ttfx_effect_args() {
  local effect=$1
  if [[ -n $effect ]]; then
    TTFX_ARGS=(-i "$RUN_TMP" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --no-eol --no-restore-cursor "$effect")
  else
    TTFX_ARGS=(-i "$RUN_TMP" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor)
  fi
}

run_ttfx_effect() {
  ttfx_effect_args "$1"
  ttfx "${TTFX_ARGS[@]}"
}

exec_ttfx_effect() {
  ttfx_effect_args "$1"
  [[ -n $BEAT_FD ]] && exec {BEAT_FD}<&- || true
  [[ -n $BEAT_WRITE_FD ]] && exec {BEAT_WRITE_FD}>&- || true
  exec ttfx "${TTFX_ARGS[@]}"
}

run() {
  local effect=$1 text_mode=$2 custom_text=$3 timeout=$4 beat_reactive=$5
  USE_FIGLET=${6:-false}
  if [[ $USE_FIGLET == true ]]; then
    FIGLET_FONT_PATH=$(resolve_figlet_font "${7:-}" || true)
  else
    FIGLET_FONT_PATH=""
  fi
  FONT_SIZE_MAX=${8:-28}
  if [[ -n ${ALACRITTY_WINDOW_ID:-} ]] && [[ -S $ALACRITTY_SOCKET_PATH ]]; then
    ALACRITTY_SOCKET=$ALACRITTY_SOCKET_PATH
  fi
  local beat_sensitivity=${9:-medium}
  local started=$SECONDS effect_arg raw_text="" next_text detector_status effect_status effect_interrupted viewport_status
  local effect_index=0 last_text_refresh=-999 rendered_once=false
  local -a TTFX_ARGS
  have ttfx || { printf '%s\n' "OmarchySS requires ttfx." >&2; exit 1; }
  case "$beat_sensitivity" in
    low) BEAT_THRESHOLD_PERCENT=145; BEAT_COOLDOWN_FRAMES=8 ;;
    medium) BEAT_THRESHOLD_PERCENT=125; BEAT_COOLDOWN_FRAMES=6 ;;
    high) BEAT_THRESHOLD_PERCENT=112; BEAT_COOLDOWN_FRAMES=5 ;;
  esac
  local -a beat_effects=(beams bubbles fireworks matrix rain rings spotlights thunderstorm waves)
  RUN_TMP=$(mktemp "${STATE_DIR}/text.XXXXXX")
  trap 'cleanup_run; exit' EXIT INT TERM HUP
  printf '\033]11;rgb:00/00/00\007'
  # The terminal's initial size (whether from the Hyprland window rule or
  # Alacritty/foot's own defaults) can take a moment to land -- wait for it
  # to settle before the first render_text/fit_font_size_to_window call so
  # text isn't fitted against a stale, pre-resize size.
  read_settled_size >/dev/null
  if [[ $beat_reactive == true ]]; then
    start_beat_detector || beat_reactive=false
    if [[ $effect == random ]]; then
      effect_index=$((RANDOM % ${#beat_effects[@]}))
    else
      local i
      for i in "${!beat_effects[@]}"; do
        [[ ${beat_effects[$i]} == "$effect" ]] && { effect_index=$i; break; }
      done
    fi
  fi
  while :; do
    (( timeout == 0 || SECONDS - started < timeout )) || exit 0
    if [[ $rendered_once == false || $beat_reactive != true ]] || (( SECONDS - last_text_refresh >= 5 )); then
      next_text=$(determine_text "$text_mode" "$custom_text")
      [[ -n $next_text ]] || next_text=OMARCHYSS
      if [[ $next_text != "$raw_text" || -z $raw_text ]]; then
        raw_text=$next_text
        render_text "$raw_text"
        remember_viewport
      fi
      rendered_once=true
      last_text_refresh=$SECONDS
    fi
    if [[ $beat_reactive == true ]]; then
      drain_audio_frames
      effect_arg=${beat_effects[$effect_index]}
      exec_ttfx_effect "$effect_arg" &
      RUN_EFFECT_PID=$!
      effect_interrupted=false
      while kill -0 "$RUN_EFFECT_PID" 2>/dev/null; do
        (( timeout == 0 || SECONDS - started < timeout )) || exit 0
        if viewport_change_kind; then
          viewport_status=0
        else
          viewport_status=$?
        fi
        if (( viewport_status == 0 || viewport_status == 2 )); then
          kill "$RUN_EFFECT_PID" 2>/dev/null || true
          wait "$RUN_EFFECT_PID" 2>/dev/null || true
          if (( viewport_status == 2 )); then
            render_text "$raw_text"
            remember_viewport
          fi
          effect_interrupted=true
          break
        fi
        if wait_for_beat_frame; then
          kill "$RUN_EFFECT_PID" 2>/dev/null || true
          wait "$RUN_EFFECT_PID" 2>/dev/null || true
          effect_interrupted=true
          if [[ $effect == random ]]; then
            effect_index=$(( (effect_index + 1 + RANDOM % (${#beat_effects[@]} - 1)) % ${#beat_effects[@]} ))
          else
            effect_index=$(( (effect_index + 1) % ${#beat_effects[@]} ))
          fi
          break
        else
          detector_status=$?
          if (( detector_status == 2 )); then
            stop_beat_detector
            beat_reactive=false
            kill "$RUN_EFFECT_PID" 2>/dev/null || true
            effect_interrupted=true
            break
          fi
        fi
      done
      effect_status=0
      wait "$RUN_EFFECT_PID" 2>/dev/null || effect_status=$?
      RUN_EFFECT_PID=""
      if [[ $effect_interrupted == false ]] && (( effect_status != 0 )); then
        printf '%s\n' "OmarchySS: TTFX effect failed with status $effect_status." >&2
        exit "$effect_status"
      fi
    else
      effect_arg=$effect
      [[ $effect == random ]] && effect_arg=""
      exec_ttfx_effect "$effect_arg" &
      RUN_EFFECT_PID=$!
      effect_interrupted=false
      while kill -0 "$RUN_EFFECT_PID" 2>/dev/null; do
        (( timeout == 0 || SECONDS - started < timeout )) || exit 0
        if viewport_change_kind; then
          viewport_status=0
        else
          viewport_status=$?
        fi
        if (( viewport_status == 0 || viewport_status == 2 )); then
          kill "$RUN_EFFECT_PID" 2>/dev/null || true
          wait "$RUN_EFFECT_PID" 2>/dev/null || true
          if (( viewport_status == 2 )); then
            render_text "$raw_text"
            remember_viewport
          fi
          effect_interrupted=true
          break
        fi
        sleep 0.1
      done
      effect_status=0
      wait "$RUN_EFFECT_PID" 2>/dev/null || effect_status=$?
      RUN_EFFECT_PID=""
      if [[ $effect_interrupted == false ]] && (( effect_status != 0 )); then
        printf '%s\n' "OmarchySS: TTFX effect failed with status $effect_status." >&2
        exit "$effect_status"
      fi
    fi
  done
}

case "${1:-}" in
  start) shift; start "$@" ;;
  restart) shift; restart "$@" ;;
  stop) stop ;;
  status) status ;;
  media) shift; media "${1:-}" ;;
  run) shift; run "$@" ;;
  install) shift; install_command "$@" ;;
  help|-h|--help) usage ;;
  ""|--*) start_from_settings "$@" ;;
  *) usage >&2; exit 2 ;;
esac
