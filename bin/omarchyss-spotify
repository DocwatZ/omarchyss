#!/usr/bin/env python3
"""Spotify Web API helper for OmarchySS.

Handles the one-time OAuth PKCE login, refresh-token storage (via the
system's libsecret keyring through `secret-tool`), catalog search, and
remote playback control. Kept separate from bin/omarchyss (the bash
screensaver/MPRIS script) since this talks to the network and needs
JSON/HTTP handling that's painful in bash.

Usage:
  omarchyss-spotify setup <client-id>   Save a Spotify app Client ID and log in
  omarchyss-spotify auth                Log in again
  omarchyss-spotify status              Print auth/config status as JSON
  omarchyss-spotify search <query>      Search tracks, print JSON array
  omarchyss-spotify play <uri>          Start playback of a track URI
  omarchyss-spotify devices             List available Spotify Connect devices
  omarchyss-spotify transfer <id>       Transfer playback to a device
  omarchyss-spotify now-playing         Print active playback state as JSON
  omarchyss-spotify control <action>    Control the active playback device
  omarchyss-spotify preferences         Read popup screensaver preferences
  omarchyss-spotify preferences set ... Persist popup screensaver preferences
"""
import base64
import fcntl
import hashlib
import http.server
import json
import os
import re
import secrets
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.config/omarchyss")
CONFIG_FILE = os.path.join(CONFIG_DIR, "spotify.json")
REDIRECT_PORT = 8945
REDIRECT_URI = f"http://127.0.0.1:{REDIRECT_PORT}/callback"
SCOPES = "user-read-playback-state user-modify-playback-state user-read-currently-playing"
KEYRING_SERVICE = "omarchyss"
KEYRING_KEY = "spotify-refresh-token"
API_BASE = "https://api.spotify.com/v1"
ACCOUNTS_BASE = "https://accounts.spotify.com"
DEVICE_NAME = "OmarchySS"
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omarchyss")
SPOTIFYD_CACHE_DIR = os.path.join(STATE_DIR, "spotifyd-cache")
SPOTIFYD_CREDENTIAL_FILE = os.path.join(SPOTIFYD_CACHE_DIR, "oauth", "credentials.json")
SPOTIFYD_PID_FILE = os.path.join(STATE_DIR, "spotifyd.pid")
SPOTIFYD_LOCK_FILE = os.path.join(STATE_DIR, "spotifyd.lock")
SPOTIFYD_LOG_FILE = os.path.join(STATE_DIR, "spotifyd.log")
SPOTIFYD_OAUTH_PORT = 8946
RATE_LIMIT_FILE = os.path.join(STATE_DIR, "player-cooldown.json")

# Spotify rate-limits the player endpoints per account, and answers a blocked
# request with a Retry-After that can run to many hours. Requests sent during
# that window still count against it, so the cooldown is stored on disk: the
# bar widget starts a fresh helper process for every poll, and an in-memory
# backoff would be forgotten between them (and on every shell restart).
PLAYER_PATH_PREFIX = "/me/player"


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


# A Client ID that shipped hardcoded in the plugin (removed after its shared
# Spotify Web API quota was exhausted). Configs written by those releases
# have this saved as "client_id" even though the user never entered it, so
# it must be purged -- otherwise cmd_status keeps reporting "configured" and
# the popup never prompts for a personal Client ID.
LEGACY_SHARED_CLIENT_ID = "0388ab0cbad445a4a67499815dc37891"


def load_config():
    if not os.path.isfile(CONFIG_FILE):
        return {}
    with open(CONFIG_FILE) as f:
        config = json.load(f)
    if config.get("client_id") == LEGACY_SHARED_CLIENT_ID:
        config.pop("client_id", None)
        config.pop("access_token", None)
        config.pop("access_token_expires_at", None)
        keyring_clear()
        save_config(config, preferences_authoritative=True)
    return config


def save_config(config, preferences_authoritative=False):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    lock_path = f"{CONFIG_FILE}.lock"
    with open(lock_path, "w") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not preferences_authoritative and os.path.isfile(CONFIG_FILE):
            try:
                with open(CONFIG_FILE) as current_file:
                    current = json.load(current_file)
                if "preferences" in current:
                    config["preferences"] = current["preferences"]
            except (OSError, json.JSONDecodeError):
                pass
        fd, temporary_path = tempfile.mkstemp(prefix="spotify.", dir=CONFIG_DIR)
        try:
            with os.fdopen(fd, "w") as temporary_file:
                json.dump(config, temporary_file, indent=2)
                temporary_file.flush()
                os.fsync(temporary_file.fileno())
            os.chmod(temporary_path, 0o600)
            os.replace(temporary_path, CONFIG_FILE)
        finally:
            try:
                os.unlink(temporary_path)
            except FileNotFoundError:
                pass


def ensure_private_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)


def keyring_store(refresh_token):
    subprocess.run(
        ["secret-tool", "store", "--label=OmarchySS Spotify refresh token",
         "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        input=refresh_token, text=True, check=True,
    )


def keyring_lookup():
    result = subprocess.run(
        ["secret-tool", "lookup", "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        capture_output=True, text=True,
    )
    token = result.stdout.strip()
    return token if result.returncode == 0 and token else None


def keyring_clear():
    subprocess.run(
        ["secret-tool", "clear", "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        capture_output=True, text=True,
    )


def http_json(url, data=None, headers=None, method=None):
    headers = headers or {}
    body = None
    if data is not None:
        body = urllib.parse.urlencode(data).encode()
        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read()
            try:
                payload = json.loads(raw) if raw.strip() else {}
            except json.JSONDecodeError:
                payload = {}
            return resp.status, payload
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            payload = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            payload = {"error": raw.decode(errors="replace")}
        return e.code, payload


def reject_legacy_client_id(client_id):
    if client_id.lower() == LEGACY_SHARED_CLIENT_ID:
        die("omarchyss-spotify: that Client ID is the old shared app bundled "
            "with earlier releases, and its Spotify API quota is exhausted. "
            "Create your own free app at "
            "https://developer.spotify.com/dashboard (redirect URI "
            "http://127.0.0.1:8945/callback) and enter its Client ID instead.")


def require_client_id(config):
    client_id = config.get("client_id", "")
    if not re.fullmatch(r"[0-9a-fA-F]{32}", client_id):
        die("omarchyss-spotify: no valid Spotify Client ID configured. "
            "Run: omarchyss-spotify setup <client-id>")
    return client_id


def pkce_pair():
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    return verifier, challenge


def cmd_setup(args):
    if len(args) != 1 or not re.fullmatch(r"[0-9a-fA-F]{32}", args[0]):
        die("Usage: omarchyss-spotify setup <32-character-client-id>", 2)
    reject_legacy_client_id(args[0])
    config = load_config()
    config["client_id"] = args[0]
    save_config(config)
    cmd_auth([])


def cmd_auth(_args):
    config = load_config()
    client_id = require_client_id(config)
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(16)

    auth_params = {
        "client_id": client_id,
        "response_type": "code",
        "redirect_uri": REDIRECT_URI,
        "code_challenge_method": "S256",
        "code_challenge": challenge,
        "scope": SCOPES,
        "state": state,
    }
    auth_url = f"{ACCOUNTS_BASE}/authorize?{urllib.parse.urlencode(auth_params)}"

    received = {}
    event = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path != "/callback":
                self.send_response(404)
                self.end_headers()
                return
            query = urllib.parse.parse_qs(parsed.query)
            received["code"] = query.get("code", [None])[0]
            received["state"] = query.get("state", [None])[0]
            received["error"] = query.get("error", [None])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            ok = received.get("code") and not received.get("error")
            message = "You can close this tab and return to OmarchySS." if ok else "Spotify login failed. You can close this tab."
            self.wfile.write(f"<html><body style='font-family:sans-serif'><h2>{message}</h2></body></html>".encode())
            event.set()

    server = http.server.HTTPServer(("127.0.0.1", REDIRECT_PORT), Handler)
    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()

    opened = subprocess.run(["xdg-open", auth_url], capture_output=True)
    if opened.returncode != 0:
        print("Open this URL in a browser to log in to Spotify:")
        print(auth_url)

    print("Waiting for Spotify login in your browser...")
    if not event.wait(timeout=180):
        server.shutdown()
        die("Timed out waiting for Spotify login.")
    server.shutdown()

    if received.get("error") or not received.get("code"):
        die(f"Spotify login failed: {received.get('error', 'no code returned')}")
    if received.get("state") != state:
        die("Spotify login failed: state mismatch (possible CSRF).")

    status, payload = http_json(
        f"{ACCOUNTS_BASE}/api/token",
        data={
            "client_id": client_id,
            "grant_type": "authorization_code",
            "code": received["code"],
            "redirect_uri": REDIRECT_URI,
            "code_verifier": verifier,
        },
    )
    if status != 200 or "refresh_token" not in payload:
        die(f"Spotify token exchange failed: {payload}")

    keyring_store(payload["refresh_token"])
    config["access_token"] = payload["access_token"]
    config["access_token_expires_at"] = time.time() + payload.get("expires_in", 3600) - 30
    config["granted_scopes"] = payload.get("scope", SCOPES).split()
    save_config(config)
    stop_spotifyd()
    try:
        os.unlink(SPOTIFYD_CREDENTIAL_FILE)
    except FileNotFoundError:
        pass
    authenticate_spotifyd()
    start_spotifyd()
    print("Spotify login complete. OmarchySS is ready as a playback device.")


def get_access_token(config):
    if config.get("access_token") and time.time() < config.get("access_token_expires_at", 0):
        return config["access_token"]

    client_id = require_client_id(config)
    refresh_token = keyring_lookup()
    if not refresh_token:
        die("omarchyss-spotify: not logged in. Run: omarchyss-spotify auth")

    status, payload = http_json(
        f"{ACCOUNTS_BASE}/api/token",
        data={
            "client_id": client_id,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        },
    )
    if status != 200 or "access_token" not in payload:
        die(f"omarchyss-spotify: token refresh failed ({status}): {payload}")

    config["access_token"] = payload["access_token"]
    config["access_token_expires_at"] = time.time() + payload.get("expires_in", 3600) - 30
    if payload.get("refresh_token"):
        keyring_store(payload["refresh_token"])
    save_config(config)
    return config["access_token"]


def retry_suffix(payload):
    """Machine-readable hint the bar widget parses to size its own backoff."""
    retry = payload.get("retryAfter") if isinstance(payload, dict) else None
    return f" retryAfter={int(retry)}" if retry else ""


def player_cooldown_remaining():
    """Seconds left on a server-requested player-endpoint cooldown, else 0."""
    try:
        with open(RATE_LIMIT_FILE) as f:
            until = float(json.load(f).get("until", 0))
    except (OSError, ValueError, TypeError, json.JSONDecodeError):
        return 0
    return max(0, int(until - time.time()))


def record_player_cooldown(retry_after):
    try:
        seconds = int(retry_after)
    except (TypeError, ValueError):
        seconds = 60
    # Spotify sometimes answers with a very small Retry-After even though the
    # block is longer; keep a floor so a burst can't slip straight back in.
    seconds = max(60, seconds)
    try:
        ensure_private_dir(STATE_DIR)
        with open(RATE_LIMIT_FILE, "w") as f:
            json.dump({"until": time.time() + seconds}, f)
        os.chmod(RATE_LIMIT_FILE, 0o600)
    except OSError:
        pass
    return seconds


def clear_player_cooldown():
    try:
        os.unlink(RATE_LIMIT_FILE)
    except OSError:
        pass


def api_request(config, path, method="GET", body=None):
    is_player = path.startswith(PLAYER_PATH_PREFIX)
    if is_player:
        remaining = player_cooldown_remaining()
        if remaining > 0:
            # Fail without touching the network: requests sent while blocked
            # keep the block alive.
            return 429, {
                "error": {
                    "status": 429,
                    "message": "Too many requests",
                    "reason": "QUOTA_EXCEEDED",
                },
                "retryAfter": remaining,
            }

    token = get_access_token(config)
    headers = {"Authorization": f"Bearer {token}"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(f"{API_BASE}{path}", data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read()
            try:
                payload = json.loads(raw) if raw.strip() else {}
            except json.JSONDecodeError:
                payload = {}
            if is_player:
                clear_player_cooldown()
            return resp.status, payload
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            payload = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            payload = {"error": raw.decode(errors="replace")}
        if e.code == 429:
            payload["retryAfter"] = record_player_cooldown(e.headers.get("Retry-After"))
        return e.code, payload


def managed_spotifyd_pid():
    try:
        with open(SPOTIFYD_PID_FILE) as f:
            pid = int(f.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            command = f.read().replace(b"\0", b" ").decode(errors="replace")
        if "spotifyd" in command and SPOTIFYD_CACHE_DIR in command:
            return pid
    except (FileNotFoundError, PermissionError, ProcessLookupError, ValueError):
        pass
    try:
        os.unlink(SPOTIFYD_PID_FILE)
    except FileNotFoundError:
        pass
    return None


def spotifyd_log_tail():
    try:
        with open(SPOTIFYD_LOG_FILE, errors="replace") as f:
            lines = f.readlines()
        return "".join(lines[-8:]).strip()
    except OSError:
        return ""


def spotifyd_authenticated():
    return os.path.isfile(SPOTIFYD_CREDENTIAL_FILE)


def authenticate_spotifyd():
    if spotifyd_authenticated():
        return
    if not os.path.isfile("/usr/bin/spotifyd"):
        die("spotifyd is required. Install it with: omarchy pkg add spotifyd")
    ensure_private_dir(STATE_DIR)
    ensure_private_dir(SPOTIFYD_CACHE_DIR)
    try:
        result = subprocess.run(
            [
                "/usr/bin/spotifyd",
                "authenticate",
                "--cache-path", SPOTIFYD_CACHE_DIR,
                "--oauth-port", str(SPOTIFYD_OAUTH_PORT),
            ],
            capture_output=True,
            text=True,
            timeout=180,
        )
    except subprocess.TimeoutExpired:
        die("Timed out waiting for Spotify playback authorization.")
    if result.returncode != 0 or not spotifyd_authenticated():
        detail = (result.stderr or result.stdout).strip()
        die(f"Spotify playback authorization failed{': ' + detail if detail else '.'}")
    os.chmod(SPOTIFYD_CREDENTIAL_FILE, 0o600)


def start_spotifyd():
    if not spotifyd_authenticated():
        die("Authorize the OmarchySS playback device first.")
    if not os.path.isfile("/usr/bin/spotifyd"):
        die("spotifyd is required. Install it with: omarchy pkg add spotifyd")

    ensure_private_dir(STATE_DIR)
    ensure_private_dir(SPOTIFYD_CACHE_DIR)
    with open(SPOTIFYD_LOCK_FILE, "w") as lock:
        os.chmod(SPOTIFYD_LOCK_FILE, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if managed_spotifyd_pid():
            return
        log = open(SPOTIFYD_LOG_FILE, "wb", buffering=0)
        try:
            process = subprocess.Popen(
                [
                    "/usr/bin/spotifyd",
                    "--config-path", "/dev/null",
                    "--no-daemon",
                    "--device-name", DEVICE_NAME,
                    "--device-type", "computer",
                    "--bitrate", "320",
                    "--backend", "pulseaudio",
                    "--cache-path", SPOTIFYD_CACHE_DIR,
                    "--max-cache-size", "536870912",
                    "--volume-normalisation",
                    "--disable-discovery",
                    "--use-mpris",
                    "--dbus-type", "session",
                ],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=log,
                start_new_session=True,
            )
        finally:
            log.close()
        with open(SPOTIFYD_PID_FILE, "w") as f:
            f.write(f"{process.pid}\n")
        os.chmod(SPOTIFYD_PID_FILE, 0o600)
        time.sleep(1)
        if process.poll() is not None:
            try:
                os.unlink(SPOTIFYD_PID_FILE)
            except FileNotFoundError:
                pass
            detail = spotifyd_log_tail()
            die(f"OmarchySS playback device failed to start{': ' + detail if detail else '.'}")


def stop_spotifyd():
    pid = managed_spotifyd_pid()
    if not pid:
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    for _ in range(30):
        if not os.path.exists(f"/proc/{pid}"):
            break
        time.sleep(0.1)
    if os.path.exists(f"/proc/{pid}"):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        os.unlink(SPOTIFYD_PID_FILE)
    except FileNotFoundError:
        pass


def find_omarchyss_device(config, wait_seconds=0):
    deadline = time.time() + wait_seconds
    while True:
        status, payload = api_request(config, "/me/player/devices")
        if status == 200:
            device = next(
                (item for item in payload.get("devices", []) if item.get("name") == DEVICE_NAME),
                None,
            )
            if device:
                return device
        if time.time() >= deadline:
            return None
        time.sleep(0.5)


# spotifyd exposes its MPRIS interface under rs.spotifyd.instance<pid> rather
# than the org.mpris.MediaPlayer2.* name generic MPRIS clients scan for, so it
# has to be addressed explicitly. Going through D-Bus keeps the local device
# usable while Spotify's Web API player endpoints are rate limited.
MPRIS_PATH = "/org/mpris/MediaPlayer2"
MPRIS_PLAYER_IFACE = "org.mpris.MediaPlayer2.Player"
SPOTIFYD_CONTROLS_PATH = "/rs/spotifyd/Controls"
SPOTIFYD_CONTROLS_IFACE = "rs.spotifyd.Controls"


def spotifyd_bus_name():
    pid = managed_spotifyd_pid()
    preferred = f"rs.spotifyd.instance{pid}" if pid else None
    try:
        listing = subprocess.run(
            ["busctl", "--user", "list", "--no-legend"],
            capture_output=True, text=True, timeout=5,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    names = [
        line.split()[0]
        for line in listing.splitlines()
        if line.split() and line.split()[0].startswith("rs.spotifyd.instance")
    ]
    if preferred and preferred in names:
        return preferred
    return names[0] if names else None


def busctl_call(name, path, iface, method, *args):
    command = ["busctl", "--user", "call", name, path, iface, method]
    command.extend(str(a) for a in args)
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def busctl_get(name, prop, iface=MPRIS_PLAYER_IFACE, path=MPRIS_PATH):
    try:
        result = subprocess.run(
            ["busctl", "--user", "--json=short", "get-property", name, path, iface, prop],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout).get("data")
    except (json.JSONDecodeError, AttributeError):
        return None


def unwrap_variant(value):
    """busctl --json=short wraps every value as {"type":..., "data":...}."""
    if isinstance(value, dict) and set(value.keys()) == {"type", "data"}:
        return unwrap_variant(value["data"])
    if isinstance(value, dict):
        return {k: unwrap_variant(v) for k, v in value.items()}
    if isinstance(value, list):
        return [unwrap_variant(v) for v in value]
    return value


def local_player_available():
    return spotifyd_bus_name() is not None


def local_activate(name=None):
    """Make spotifyd the active Connect device without using the Web API."""
    name = name or spotifyd_bus_name()
    if not name:
        return False
    if busctl_get(name, "PlaybackStatus") is not None:
        return True
    if not busctl_call(name, SPOTIFYD_CONTROLS_PATH, SPOTIFYD_CONTROLS_IFACE, "TransferPlayback"):
        return False
    # The MPRIS object is only exported once the device becomes active.
    for _ in range(24):
        if busctl_get(name, "PlaybackStatus") is not None:
            return True
        time.sleep(0.25)
    return False


def local_track_id():
    """Spotify track id currently loaded, from mpris:trackid."""
    name = spotifyd_bus_name()
    if not name:
        return ""
    metadata = unwrap_variant(busctl_get(name, "Metadata")) or {}
    trackid = str(metadata.get("mpris:trackid", ""))
    return trackid.rsplit("/", 1)[-1] if "/spotify/track/" in trackid else ""


def wait_for_track(expected_id, timeout=8.0):
    """Wait for a track to load; returns the id that actually started."""
    deadline = time.time() + timeout
    current = ""
    while time.time() < deadline:
        current = local_track_id()
        if current == expected_id:
            return current
        time.sleep(0.25)
    return current


def album_context_offset_uri(config, target_uri):
    """URI to hand OpenUri so spotifyd's off-by-one lands on target_uri.

    spotifyd 0.4.2 loads the track's album as the context and passes the
    track's 1-based number as a 0-based index, so it starts the following
    track. Feeding it the track one position earlier cancels that out
    exactly. Only /me/player* is rate limited, so these lookups still work
    while remote control is blocked.
    """
    track_id = target_uri.rsplit(":", 1)[-1]
    status, track = api_request(config, f"/tracks/{track_id}")
    if status != 200:
        return None
    album_id = (track.get("album") or {}).get("id")
    if not album_id:
        return None
    number = track.get("track_number") or 0
    disc = track.get("disc_number") or 1

    status, payload = api_request(config, f"/albums/{album_id}/tracks?limit=50")
    if status != 200:
        return None
    items = payload.get("items", [])

    # The context index counts across discs, while track_number restarts on
    # each disc, so work out the target's absolute position first.
    ordered = sorted(
        items,
        key=lambda i: ((i.get("disc_number") or 1), (i.get("track_number") or 0)),
    )
    position = next(
        (
            index
            for index, item in enumerate(ordered)
            if (item.get("disc_number") or 1) == disc
            and (item.get("track_number") or 0) == number
        ),
        None,
    )
    if position is None:
        return None
    if position == 0:
        # Album URIs load at index 0, which is exactly the first track.
        return f"spotify:album:{album_id}"
    # Need spotifyd to use index `position`, so hand it a track numbered
    # `position`; that is the preceding track on a single-disc album.
    donor = next(
        (item for item in items if (item.get("track_number") or 0) == position),
        None,
    )
    return donor.get("uri") if donor else None


def local_play(uri):
    name = spotifyd_bus_name()
    if not name or not local_activate(name):
        return False
    wanted = uri.rsplit(":", 1)[-1]

    open_uri = uri
    try:
        adjusted = album_context_offset_uri(load_config(), uri)
        if adjusted:
            open_uri = adjusted
    except SystemExit:
        raise
    except Exception:
        open_uri = uri

    if not busctl_call(name, MPRIS_PATH, MPRIS_PLAYER_IFACE, "OpenUri", "s", open_uri):
        return False
    # Always confirm the intended track actually started; never let a
    # mismatch pass silently as playing the wrong song.
    if wait_for_track(wanted, timeout=8.0) == wanted:
        return True
    if open_uri != uri:
        # spotifyd may have been fixed upstream, in which case the
        # compensation is what threw it off -- retry with the plain URI.
        if busctl_call(name, MPRIS_PATH, MPRIS_PLAYER_IFACE, "OpenUri", "s", uri):
            if wait_for_track(wanted, timeout=8.0) == wanted:
                return True
    return False


LOCAL_CONTROL_METHODS = {
    "play-pause": "PlayPause",
    "play": "Play",
    "pause": "Pause",
    "next": "Next",
    "previous": "Previous",
}


def local_control(action):
    name = spotifyd_bus_name()
    if not name or not local_activate(name):
        return False
    method = LOCAL_CONTROL_METHODS.get(action)
    if method:
        return busctl_call(name, MPRIS_PATH, MPRIS_PLAYER_IFACE, method)
    return False


def local_now_playing():
    name = spotifyd_bus_name()
    if not name:
        return {}
    status = busctl_get(name, "PlaybackStatus")
    if status is None:
        return {}
    metadata = unwrap_variant(busctl_get(name, "Metadata")) or {}
    artists = metadata.get("xesam:artist") or []
    if isinstance(artists, str):
        artists = [artists]
    length_us = metadata.get("mpris:length") or 0
    position_us = busctl_get(name, "Position") or 0
    volume = busctl_get(name, "Volume")
    title = metadata.get("xesam:title", "")
    return {
        "active": True,
        "isPlaying": status == "Playing",
        "title": title,
        "artists": ", ".join(a for a in artists if a),
        "album": metadata.get("xesam:album", ""),
        "image": metadata.get("mpris:artUrl", ""),
        "progressMs": int(position_us) // 1000,
        "durationMs": int(length_us) // 1000,
        "volumePercent": int(round(volume * 100)) if isinstance(volume, (int, float)) else None,
        "shuffle": busctl_get(name, "Shuffle") is True,
        "repeatState": "off",
        "local": True,
        "device": {"id": "", "name": DEVICE_NAME, "type": "computer"},
    }


def cmd_status(_args):
    config = load_config()
    print(json.dumps({
        "configured": bool(re.fullmatch(r"[0-9a-fA-F]{32}", config.get("client_id", ""))),
        "loggedIn": bool(keyring_lookup()),
        "playbackReady": spotifyd_authenticated(),
        "deviceRunning": bool(managed_spotifyd_pid()),
        "playerCooldown": player_cooldown_remaining(),
        "preferences": config.get("preferences", {}),
    }))


def cmd_search(args):
    if not args:
        die("Usage: omarchyss-spotify search <query> [limit]")
    query = args[0]
    limit = args[1] if len(args) > 1 else "8"
    config = load_config()
    status, payload = api_request(
        config, f"/search?{urllib.parse.urlencode({'q': query, 'type': 'track', 'limit': limit})}"
    )
    if status != 200:
        die(f"omarchyss-spotify: search failed ({status}): {payload.get('error', payload)}{retry_suffix(payload)}")
    tracks = payload.get("tracks", {}).get("items", [])
    results = []
    for t in tracks:
        images = (t.get("album") or {}).get("images") or []
        image = images[-1]["url"] if images else ""
        results.append({
            "uri": t.get("uri", ""),
            "name": t.get("name", ""),
            "artists": ", ".join(a.get("name", "") for a in t.get("artists", [])),
            "album": (t.get("album") or {}).get("name", ""),
            "image": image,
        })
    print(json.dumps(results))


def cmd_devices(_args):
    config = load_config()
    if player_cooldown_remaining() > 0 and local_player_available():
        # Surface the local device so playback stays selectable while the Web
        # API player endpoints are blocked.
        print(json.dumps([{
            "id": "",
            "name": f"{DEVICE_NAME} (local)",
            "type": "Computer",
            "is_active": busctl_get(spotifyd_bus_name(), "PlaybackStatus") is not None,
        }]))
        return
    status, payload = api_request(config, "/me/player/devices")
    if status != 200:
        die(f"omarchyss-spotify: devices failed ({status}): {payload.get('error', payload)}{retry_suffix(payload)}")
    print(json.dumps(payload.get("devices", [])))


def cmd_transfer(args):
    if len(args) != 1:
        die("Usage: omarchyss-spotify transfer <device-id>", 2)
    config = load_config()
    status, payload = api_request(config, "/me/player/devices")
    if status != 200:
        die(f"omarchyss-spotify: devices failed ({status}): {payload.get('error', payload)}{retry_suffix(payload)}")
    device = next((item for item in payload.get("devices", []) if item.get("id") == args[0]), None)
    if not device:
        die("That Spotify device is no longer available. Refresh the device list and try again.")
    playback = current_playback(config)
    status, payload = api_request(
        config,
        "/me/player",
        method="PUT",
        body={"device_ids": [device["id"]], "play": playback.get("isPlaying") is True},
    )
    if status not in (200, 204):
        die(f"Could not switch to {device.get('name', 'that device')} ({status}): "
            f"{payload.get('error', payload)}{retry_suffix(payload)}")
    print(json.dumps({"id": device["id"], "name": device.get("name", "")}))


def current_playback(config):
    status, payload = api_request(config, "/me/player")
    if status == 204:
        return {}
    if status != 200:
        die(f"omarchyss-spotify: playback state failed ({status}): {payload.get('error', payload)}{retry_suffix(payload)}")
    item = payload.get("item") or {}
    album = item.get("album") or {}
    images = album.get("images") or []
    device = payload.get("device") or {}
    return {
        "active": bool(device.get("id")),
        "isPlaying": payload.get("is_playing") is True,
        "title": item.get("name", ""),
        "artists": ", ".join(artist.get("name", "") for artist in item.get("artists", [])),
        "album": album.get("name", ""),
        "image": images[0].get("url", "") if images else "",
        "progressMs": payload.get("progress_ms") or 0,
        "durationMs": item.get("duration_ms") or 0,
        "volumePercent": device.get("volume_percent"),
        "shuffle": payload.get("shuffle_state") is True,
        "repeatState": payload.get("repeat_state", "off"),
        "device": {
            "id": device.get("id", ""),
            "name": device.get("name", ""),
            "type": device.get("type", ""),
        },
    }


def cmd_now_playing(_args):
    if player_cooldown_remaining() > 0:
        print(json.dumps(local_now_playing()))
        return
    print(json.dumps(current_playback(load_config())))


def cmd_control(args):
    if not args:
        die("Usage: omarchyss-spotify control {play-pause|play|pause|next|previous|seek|volume|shuffle|repeat}", 2)
    action = args[0]
    if player_cooldown_remaining() > 0:
        # Transport control still works over D-Bus while the Web API is
        # blocked; only the richer actions genuinely need the Web API.
        if local_control(action):
            return
        die(f"omarchyss-spotify: control failed (429): Spotify paused remote control.{retry_suffix({'retryAfter': player_cooldown_remaining()})}")
    config = load_config()
    method = "PUT"
    path = ""

    if action == "play-pause":
        playback = current_playback(config)
        if not playback.get("active"):
            die("No active Spotify playback device.")
        path = "/me/player/pause" if playback.get("isPlaying") else "/me/player/play"
    elif action in ("play", "pause"):
        path = f"/me/player/{action}"
    elif action in ("next", "previous"):
        method = "POST"
        path = f"/me/player/{action}"
    elif action == "seek" and len(args) == 2:
        try:
            position_ms = max(0, int(args[1]))
        except ValueError:
            die("Seek position must be milliseconds.", 2)
        path = f"/me/player/seek?{urllib.parse.urlencode({'position_ms': position_ms})}"
    elif action == "volume" and len(args) == 2:
        try:
            volume = min(100, max(0, int(args[1])))
        except ValueError:
            die("Volume must be between 0 and 100.", 2)
        path = f"/me/player/volume?{urllib.parse.urlencode({'volume_percent': volume})}"
    elif action == "shuffle" and len(args) == 2 and args[1] in ("true", "false"):
        path = f"/me/player/shuffle?{urllib.parse.urlencode({'state': args[1]})}"
    elif action == "repeat" and len(args) == 2 and args[1] in ("off", "track", "context"):
        path = f"/me/player/repeat?{urllib.parse.urlencode({'state': args[1]})}"
    else:
        die("Invalid Spotify control action or value.", 2)

    status, payload = api_request(config, path, method=method)
    if status not in (200, 202, 204):
        die(f"Spotify control failed ({status}): {payload.get('error', payload)}{retry_suffix(payload)}")
    print(json.dumps({"ok": True, "action": action}))


def cmd_preferences(args):
    config = load_config()
    preferences = config.setdefault("preferences", {})
    if not args:
        print(json.dumps(preferences))
        return
    if args[0] != "set" or len(args) < 3 or len(args[1:]) % 2 != 0:
        die("Usage: omarchyss-spotify preferences set <key> <value> [...]", 2)

    allowed = {"beatReactive", "beatSensitivity", "customText", "textMode"}
    for index in range(1, len(args), 2):
        key, value = args[index], args[index + 1]
        if key not in allowed:
            die(f"Unknown preference: {key}", 2)
        if key == "beatReactive":
            if value not in ("true", "false"):
                die("beatReactive must be true or false.", 2)
            preferences[key] = value == "true"
        elif key == "textMode":
            if value not in ("track", "custom"):
                die("textMode must be track or custom.", 2)
            preferences[key] = value
        elif key == "beatSensitivity":
            if value not in ("low", "medium", "high"):
                die("beatSensitivity must be low, medium, or high.", 2)
            preferences[key] = value
        else:
            preferences[key] = value
    save_config(config, preferences_authoritative=True)
    print(json.dumps(preferences))


def cmd_play(args):
    if not args:
        die("Usage: omarchyss-spotify play <uri> [device_id]")
    uri = args[0]
    if not uri.startswith("spotify:track:"):
        die("omarchyss-spotify: play requires a Spotify track URI.")
    config = load_config()
    status, payload = api_request(config, "/me/player/devices")
    if status == 429:
        # Web API playback is blocked; drive the local spotifyd device over
        # D-Bus instead of starting spotifyd and polling for a device we
        # cannot reach.
        start_spotifyd()
        if local_play(uri):
            return
        die("omarchyss-spotify: could not start that track on the local device.")
    devices = payload.get("devices", []) if status == 200 else []
    requested_device_id = args[1] if len(args) > 1 else ""
    device = next(
        (item for item in devices if item.get("id") == requested_device_id),
        None,
    )
    if not device:
        device = next((item for item in devices if item.get("is_active")), None)
    if not device:
        start_spotifyd()
        device = find_omarchyss_device(config, wait_seconds=15)
    if not device:
        die("No Spotify playback device is available.")
    path = f"/me/player/play?{urllib.parse.urlencode({'device_id': device['id']})}"
    status, payload = api_request(config, path, method="PUT", body={"uris": [uri]})
    if status not in (200, 204):
        die(f"omarchyss-spotify: play failed ({status}): {payload.get('error', payload)}{retry_suffix(payload)}\n"
            "(Playback requires Spotify Premium.)")


def cmd_device(args):
    action = args[0] if args else "status"
    if action == "setup":
        authenticate_spotifyd()
        start_spotifyd()
        print(json.dumps({"running": True, "ready": True, "name": DEVICE_NAME}))
    elif action == "start":
        start_spotifyd()
        print(json.dumps({"running": True, "name": DEVICE_NAME}))
    elif action == "stop":
        stop_spotifyd()
        print(json.dumps({"running": False, "name": DEVICE_NAME}))
    elif action == "status":
        print(json.dumps({"running": bool(managed_spotifyd_pid()), "name": DEVICE_NAME}))
    else:
        die("Usage: omarchyss-spotify device {setup|start|stop|status}", 2)


def cmd_logout(_args):
    stop_spotifyd()
    try:
        os.unlink(SPOTIFYD_CREDENTIAL_FILE)
    except FileNotFoundError:
        pass
    keyring_clear()
    config = load_config()
    config.pop("access_token", None)
    config.pop("access_token_expires_at", None)
    save_config(config)
    print("Logged out of Spotify.")


COMMANDS = {
    "setup": cmd_setup,
    "auth": cmd_auth,
    "status": cmd_status,
    "search": cmd_search,
    "devices": cmd_devices,
    "play": cmd_play,
    "transfer": cmd_transfer,
    "now-playing": cmd_now_playing,
    "control": cmd_control,
    "preferences": cmd_preferences,
    "device": cmd_device,
    "logout": cmd_logout,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die(f"Usage: omarchyss-spotify {{{'|'.join(COMMANDS)}}}", 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
