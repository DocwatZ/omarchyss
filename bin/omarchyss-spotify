#!/usr/bin/env python3
"""Spotify Web API helper for OmarchySS.

Handles the one-time OAuth PKCE login, refresh-token storage (via the
system's libsecret keyring through `secret-tool`), catalog search, and
remote playback control. Kept separate from bin/omarchyss (the bash
screensaver/MPRIS script) since this talks to the network and needs
JSON/HTTP handling that's painful in bash.

Usage:
  omarchyss-spotify setup               One-time browser login (PKCE)
  omarchyss-spotify auth                Log in again
  omarchyss-spotify status              Print auth/config status as JSON
  omarchyss-spotify search <query>      Search tracks, print JSON array
  omarchyss-spotify play <uri>          Start playback of a track URI
  omarchyss-spotify devices             List available Spotify Connect devices
  omarchyss-spotify transfer <id>       Transfer playback to a device
  omarchyss-spotify now-playing         Print active playback state as JSON
  omarchyss-spotify control <action>    Control the active playback device
  omarchyss-spotify preferences         Read popup screensaver preferences
  omarchyss-spotify preferences set ... Persist popup screensaver preferences
"""
import base64
import fcntl
import hashlib
import http.server
import json
import os
import secrets
import signal
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.config/omarchyss")
CONFIG_FILE = os.path.join(CONFIG_DIR, "spotify.json")
REDIRECT_PORT = 8945
REDIRECT_URI = f"http://127.0.0.1:{REDIRECT_PORT}/callback"
SCOPES = "user-read-playback-state user-modify-playback-state user-read-currently-playing"
KEYRING_SERVICE = "omarchyss"
KEYRING_KEY = "spotify-refresh-token"
API_BASE = "https://api.spotify.com/v1"
ACCOUNTS_BASE = "https://accounts.spotify.com"
CLIENT_ID = "0388ab0cbad445a4a67499815dc37891"
DEVICE_NAME = "OmarchySS"
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omarchyss")
SPOTIFYD_CACHE_DIR = os.path.join(STATE_DIR, "spotifyd-cache")
SPOTIFYD_CREDENTIAL_FILE = os.path.join(SPOTIFYD_CACHE_DIR, "oauth", "credentials.json")
SPOTIFYD_PID_FILE = os.path.join(STATE_DIR, "spotifyd.pid")
SPOTIFYD_LOCK_FILE = os.path.join(STATE_DIR, "spotifyd.lock")
SPOTIFYD_LOG_FILE = os.path.join(STATE_DIR, "spotifyd.log")
SPOTIFYD_OAUTH_PORT = 8946


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def load_config():
    if not os.path.isfile(CONFIG_FILE):
        return {}
    with open(CONFIG_FILE) as f:
        return json.load(f)


def save_config(config, preferences_authoritative=False):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    lock_path = f"{CONFIG_FILE}.lock"
    with open(lock_path, "w") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not preferences_authoritative and os.path.isfile(CONFIG_FILE):
            try:
                with open(CONFIG_FILE) as current_file:
                    current = json.load(current_file)
                if "preferences" in current:
                    config["preferences"] = current["preferences"]
            except (OSError, json.JSONDecodeError):
                pass
        fd, temporary_path = tempfile.mkstemp(prefix="spotify.", dir=CONFIG_DIR)
        try:
            with os.fdopen(fd, "w") as temporary_file:
                json.dump(config, temporary_file, indent=2)
                temporary_file.flush()
                os.fsync(temporary_file.fileno())
            os.chmod(temporary_path, 0o600)
            os.replace(temporary_path, CONFIG_FILE)
        finally:
            try:
                os.unlink(temporary_path)
            except FileNotFoundError:
                pass


def ensure_private_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    os.chmod(path, 0o700)


def keyring_store(refresh_token):
    subprocess.run(
        ["secret-tool", "store", "--label=OmarchySS Spotify refresh token",
         "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        input=refresh_token, text=True, check=True,
    )


def keyring_lookup():
    result = subprocess.run(
        ["secret-tool", "lookup", "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        capture_output=True, text=True,
    )
    token = result.stdout.strip()
    return token if result.returncode == 0 and token else None


def keyring_clear():
    subprocess.run(
        ["secret-tool", "clear", "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        capture_output=True, text=True,
    )


def http_json(url, data=None, headers=None, method=None):
    headers = headers or {}
    body = None
    if data is not None:
        body = urllib.parse.urlencode(data).encode()
        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else {})
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            payload = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            payload = {"error": raw.decode(errors="replace")}
        return e.code, payload


def require_client_id(config):
    return config.get("client_id", CLIENT_ID)


def pkce_pair():
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    return verifier, challenge


def cmd_setup(args):
    if args:
        die("Usage: omarchyss-spotify setup")
    cmd_auth([])


def cmd_auth(_args):
    config = load_config()
    client_id = require_client_id(config)
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(16)

    auth_params = {
        "client_id": client_id,
        "response_type": "code",
        "redirect_uri": REDIRECT_URI,
        "code_challenge_method": "S256",
        "code_challenge": challenge,
        "scope": SCOPES,
        "state": state,
    }
    auth_url = f"{ACCOUNTS_BASE}/authorize?{urllib.parse.urlencode(auth_params)}"

    received = {}
    event = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path != "/callback":
                self.send_response(404)
                self.end_headers()
                return
            query = urllib.parse.parse_qs(parsed.query)
            received["code"] = query.get("code", [None])[0]
            received["state"] = query.get("state", [None])[0]
            received["error"] = query.get("error", [None])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            ok = received.get("code") and not received.get("error")
            message = "You can close this tab and return to OmarchySS." if ok else "Spotify login failed. You can close this tab."
            self.wfile.write(f"<html><body style='font-family:sans-serif'><h2>{message}</h2></body></html>".encode())
            event.set()

    server = http.server.HTTPServer(("127.0.0.1", REDIRECT_PORT), Handler)
    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()

    opened = subprocess.run(["xdg-open", auth_url], capture_output=True)
    if opened.returncode != 0:
        print("Open this URL in a browser to log in to Spotify:")
        print(auth_url)

    print("Waiting for Spotify login in your browser...")
    if not event.wait(timeout=180):
        server.shutdown()
        die("Timed out waiting for Spotify login.")
    server.shutdown()

    if received.get("error") or not received.get("code"):
        die(f"Spotify login failed: {received.get('error', 'no code returned')}")
    if received.get("state") != state:
        die("Spotify login failed: state mismatch (possible CSRF).")

    status, payload = http_json(
        f"{ACCOUNTS_BASE}/api/token",
        data={
            "client_id": client_id,
            "grant_type": "authorization_code",
            "code": received["code"],
            "redirect_uri": REDIRECT_URI,
            "code_verifier": verifier,
        },
    )
    if status != 200 or "refresh_token" not in payload:
        die(f"Spotify token exchange failed: {payload}")

    keyring_store(payload["refresh_token"])
    config["access_token"] = payload["access_token"]
    config["access_token_expires_at"] = time.time() + payload.get("expires_in", 3600) - 30
    config["granted_scopes"] = payload.get("scope", SCOPES).split()
    save_config(config)
    stop_spotifyd()
    try:
        os.unlink(SPOTIFYD_CREDENTIAL_FILE)
    except FileNotFoundError:
        pass
    authenticate_spotifyd()
    start_spotifyd()
    print("Spotify login complete. OmarchySS is ready as a playback device.")


def get_access_token(config):
    if config.get("access_token") and time.time() < config.get("access_token_expires_at", 0):
        return config["access_token"]

    client_id = require_client_id(config)
    refresh_token = keyring_lookup()
    if not refresh_token:
        die("omarchyss-spotify: not logged in. Run: omarchyss-spotify auth")

    status, payload = http_json(
        f"{ACCOUNTS_BASE}/api/token",
        data={
            "client_id": client_id,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        },
    )
    if status != 200 or "access_token" not in payload:
        die(f"omarchyss-spotify: token refresh failed ({status}): {payload}")

    config["access_token"] = payload["access_token"]
    config["access_token_expires_at"] = time.time() + payload.get("expires_in", 3600) - 30
    if payload.get("refresh_token"):
        keyring_store(payload["refresh_token"])
    save_config(config)
    return config["access_token"]


def api_request(config, path, method="GET", body=None):
    token = get_access_token(config)
    headers = {"Authorization": f"Bearer {token}"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(f"{API_BASE}{path}", data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else {})
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            payload = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            payload = {"error": raw.decode(errors="replace")}
        return e.code, payload


def managed_spotifyd_pid():
    try:
        with open(SPOTIFYD_PID_FILE) as f:
            pid = int(f.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            command = f.read().replace(b"\0", b" ").decode(errors="replace")
        if "spotifyd" in command and SPOTIFYD_CACHE_DIR in command:
            return pid
    except (FileNotFoundError, PermissionError, ProcessLookupError, ValueError):
        pass
    try:
        os.unlink(SPOTIFYD_PID_FILE)
    except FileNotFoundError:
        pass
    return None


def spotifyd_log_tail():
    try:
        with open(SPOTIFYD_LOG_FILE, errors="replace") as f:
            lines = f.readlines()
        return "".join(lines[-8:]).strip()
    except OSError:
        return ""


def spotifyd_authenticated():
    return os.path.isfile(SPOTIFYD_CREDENTIAL_FILE)


def authenticate_spotifyd():
    if spotifyd_authenticated():
        return
    if not os.path.isfile("/usr/bin/spotifyd"):
        die("spotifyd is required. Install it with: omarchy pkg add spotifyd")
    ensure_private_dir(STATE_DIR)
    ensure_private_dir(SPOTIFYD_CACHE_DIR)
    try:
        result = subprocess.run(
            [
                "/usr/bin/spotifyd",
                "authenticate",
                "--cache-path", SPOTIFYD_CACHE_DIR,
                "--oauth-port", str(SPOTIFYD_OAUTH_PORT),
            ],
            capture_output=True,
            text=True,
            timeout=180,
        )
    except subprocess.TimeoutExpired:
        die("Timed out waiting for Spotify playback authorization.")
    if result.returncode != 0 or not spotifyd_authenticated():
        detail = (result.stderr or result.stdout).strip()
        die(f"Spotify playback authorization failed{': ' + detail if detail else '.'}")
    os.chmod(SPOTIFYD_CREDENTIAL_FILE, 0o600)


def start_spotifyd():
    if not spotifyd_authenticated():
        die("Authorize the OmarchySS playback device first.")
    if not os.path.isfile("/usr/bin/spotifyd"):
        die("spotifyd is required. Install it with: omarchy pkg add spotifyd")

    ensure_private_dir(STATE_DIR)
    ensure_private_dir(SPOTIFYD_CACHE_DIR)
    with open(SPOTIFYD_LOCK_FILE, "w") as lock:
        os.chmod(SPOTIFYD_LOCK_FILE, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if managed_spotifyd_pid():
            return
        log = open(SPOTIFYD_LOG_FILE, "wb", buffering=0)
        try:
            process = subprocess.Popen(
                [
                    "/usr/bin/spotifyd",
                    "--config-path", "/dev/null",
                    "--no-daemon",
                    "--device-name", DEVICE_NAME,
                    "--device-type", "computer",
                    "--bitrate", "320",
                    "--backend", "pulseaudio",
                    "--cache-path", SPOTIFYD_CACHE_DIR,
                    "--max-cache-size", "536870912",
                    "--volume-normalisation",
                    "--disable-discovery",
                    "--use-mpris",
                    "--dbus-type", "session",
                ],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=log,
                start_new_session=True,
            )
        finally:
            log.close()
        with open(SPOTIFYD_PID_FILE, "w") as f:
            f.write(f"{process.pid}\n")
        os.chmod(SPOTIFYD_PID_FILE, 0o600)
        time.sleep(1)
        if process.poll() is not None:
            try:
                os.unlink(SPOTIFYD_PID_FILE)
            except FileNotFoundError:
                pass
            detail = spotifyd_log_tail()
            die(f"OmarchySS playback device failed to start{': ' + detail if detail else '.'}")


def stop_spotifyd():
    pid = managed_spotifyd_pid()
    if not pid:
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    for _ in range(30):
        if not os.path.exists(f"/proc/{pid}"):
            break
        time.sleep(0.1)
    if os.path.exists(f"/proc/{pid}"):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    try:
        os.unlink(SPOTIFYD_PID_FILE)
    except FileNotFoundError:
        pass


def find_omarchyss_device(config, wait_seconds=0):
    deadline = time.time() + wait_seconds
    while True:
        status, payload = api_request(config, "/me/player/devices")
        if status == 200:
            device = next(
                (item for item in payload.get("devices", []) if item.get("name") == DEVICE_NAME),
                None,
            )
            if device:
                return device
        if time.time() >= deadline:
            return None
        time.sleep(0.5)


def cmd_status(_args):
    config = load_config()
    print(json.dumps({
        "configured": True,
        "loggedIn": bool(keyring_lookup()),
        "playbackReady": spotifyd_authenticated(),
        "deviceRunning": bool(managed_spotifyd_pid()),
        "preferences": config.get("preferences", {}),
    }))


def cmd_search(args):
    if not args:
        die("Usage: omarchyss-spotify search <query> [limit]")
    query = args[0]
    limit = args[1] if len(args) > 1 else "8"
    config = load_config()
    status, payload = api_request(
        config, f"/search?{urllib.parse.urlencode({'q': query, 'type': 'track', 'limit': limit})}"
    )
    if status != 200:
        die(f"omarchyss-spotify: search failed ({status}): {payload.get('error', payload)}")
    tracks = payload.get("tracks", {}).get("items", [])
    results = []
    for t in tracks:
        images = (t.get("album") or {}).get("images") or []
        image = images[-1]["url"] if images else ""
        results.append({
            "uri": t.get("uri", ""),
            "name": t.get("name", ""),
            "artists": ", ".join(a.get("name", "") for a in t.get("artists", [])),
            "album": (t.get("album") or {}).get("name", ""),
            "image": image,
        })
    print(json.dumps(results))


def cmd_devices(_args):
    config = load_config()
    status, payload = api_request(config, "/me/player/devices")
    if status != 200:
        die(f"omarchyss-spotify: devices failed ({status}): {payload.get('error', payload)}")
    print(json.dumps(payload.get("devices", [])))


def cmd_transfer(args):
    if len(args) != 1:
        die("Usage: omarchyss-spotify transfer <device-id>", 2)
    config = load_config()
    status, payload = api_request(config, "/me/player/devices")
    if status != 200:
        die(f"omarchyss-spotify: devices failed ({status}): {payload.get('error', payload)}")
    device = next((item for item in payload.get("devices", []) if item.get("id") == args[0]), None)
    if not device:
        die("That Spotify device is no longer available. Refresh the device list and try again.")
    playback = current_playback(config)
    status, payload = api_request(
        config,
        "/me/player",
        method="PUT",
        body={"device_ids": [device["id"]], "play": playback.get("isPlaying") is True},
    )
    if status not in (200, 204):
        die(f"Could not switch to {device.get('name', 'that device')} ({status}): "
            f"{payload.get('error', payload)}")
    print(json.dumps({"id": device["id"], "name": device.get("name", "")}))


def current_playback(config):
    status, payload = api_request(config, "/me/player")
    if status == 204:
        return {}
    if status != 200:
        die(f"omarchyss-spotify: playback state failed ({status}): {payload.get('error', payload)}")
    item = payload.get("item") or {}
    album = item.get("album") or {}
    images = album.get("images") or []
    device = payload.get("device") or {}
    return {
        "active": bool(device.get("id")),
        "isPlaying": payload.get("is_playing") is True,
        "title": item.get("name", ""),
        "artists": ", ".join(artist.get("name", "") for artist in item.get("artists", [])),
        "album": album.get("name", ""),
        "image": images[0].get("url", "") if images else "",
        "progressMs": payload.get("progress_ms") or 0,
        "durationMs": item.get("duration_ms") or 0,
        "volumePercent": device.get("volume_percent"),
        "shuffle": payload.get("shuffle_state") is True,
        "repeatState": payload.get("repeat_state", "off"),
        "device": {
            "id": device.get("id", ""),
            "name": device.get("name", ""),
            "type": device.get("type", ""),
        },
    }


def cmd_now_playing(_args):
    print(json.dumps(current_playback(load_config())))


def cmd_control(args):
    if not args:
        die("Usage: omarchyss-spotify control {play-pause|play|pause|next|previous|seek|volume|shuffle|repeat}", 2)
    action = args[0]
    config = load_config()
    method = "PUT"
    path = ""

    if action == "play-pause":
        playback = current_playback(config)
        if not playback.get("active"):
            die("No active Spotify playback device.")
        path = "/me/player/pause" if playback.get("isPlaying") else "/me/player/play"
    elif action in ("play", "pause"):
        path = f"/me/player/{action}"
    elif action in ("next", "previous"):
        method = "POST"
        path = f"/me/player/{action}"
    elif action == "seek" and len(args) == 2:
        try:
            position_ms = max(0, int(args[1]))
        except ValueError:
            die("Seek position must be milliseconds.", 2)
        path = f"/me/player/seek?{urllib.parse.urlencode({'position_ms': position_ms})}"
    elif action == "volume" and len(args) == 2:
        try:
            volume = min(100, max(0, int(args[1])))
        except ValueError:
            die("Volume must be between 0 and 100.", 2)
        path = f"/me/player/volume?{urllib.parse.urlencode({'volume_percent': volume})}"
    elif action == "shuffle" and len(args) == 2 and args[1] in ("true", "false"):
        path = f"/me/player/shuffle?{urllib.parse.urlencode({'state': args[1]})}"
    elif action == "repeat" and len(args) == 2 and args[1] in ("off", "track", "context"):
        path = f"/me/player/repeat?{urllib.parse.urlencode({'state': args[1]})}"
    else:
        die("Invalid Spotify control action or value.", 2)

    status, payload = api_request(config, path, method=method)
    if status not in (200, 202, 204):
        die(f"Spotify control failed ({status}): {payload.get('error', payload)}")
    print(json.dumps({"ok": True, "action": action}))


def cmd_preferences(args):
    config = load_config()
    preferences = config.setdefault("preferences", {})
    if not args:
        print(json.dumps(preferences))
        return
    if args[0] != "set" or len(args) < 3 or len(args[1:]) % 2 != 0:
        die("Usage: omarchyss-spotify preferences set <key> <value> [...]", 2)

    allowed = {"beatReactive", "beatSensitivity", "customText", "textMode"}
    for index in range(1, len(args), 2):
        key, value = args[index], args[index + 1]
        if key not in allowed:
            die(f"Unknown preference: {key}", 2)
        if key == "beatReactive":
            if value not in ("true", "false"):
                die("beatReactive must be true or false.", 2)
            preferences[key] = value == "true"
        elif key == "textMode":
            if value not in ("track", "custom"):
                die("textMode must be track or custom.", 2)
            preferences[key] = value
        elif key == "beatSensitivity":
            if value not in ("low", "medium", "high"):
                die("beatSensitivity must be low, medium, or high.", 2)
            preferences[key] = value
        else:
            preferences[key] = value
    save_config(config, preferences_authoritative=True)
    print(json.dumps(preferences))


def cmd_play(args):
    if not args:
        die("Usage: omarchyss-spotify play <uri> [device_id]")
    uri = args[0]
    if not uri.startswith("spotify:track:"):
        die("omarchyss-spotify: play requires a Spotify track URI.")
    config = load_config()
    status, payload = api_request(config, "/me/player/devices")
    devices = payload.get("devices", []) if status == 200 else []
    requested_device_id = args[1] if len(args) > 1 else ""
    device = next(
        (item for item in devices if item.get("id") == requested_device_id),
        None,
    )
    if not device:
        device = next((item for item in devices if item.get("is_active")), None)
    if not device:
        start_spotifyd()
        device = find_omarchyss_device(config, wait_seconds=15)
    if not device:
        die("No Spotify playback device is available.")
    path = f"/me/player/play?{urllib.parse.urlencode({'device_id': device['id']})}"
    status, payload = api_request(config, path, method="PUT", body={"uris": [uri]})
    if status not in (200, 204):
        die(f"omarchyss-spotify: play failed ({status}): {payload.get('error', payload)}\n"
            "(Playback requires Spotify Premium.)")


def cmd_device(args):
    action = args[0] if args else "status"
    if action == "setup":
        authenticate_spotifyd()
        start_spotifyd()
        print(json.dumps({"running": True, "ready": True, "name": DEVICE_NAME}))
    elif action == "start":
        start_spotifyd()
        print(json.dumps({"running": True, "name": DEVICE_NAME}))
    elif action == "stop":
        stop_spotifyd()
        print(json.dumps({"running": False, "name": DEVICE_NAME}))
    elif action == "status":
        print(json.dumps({"running": bool(managed_spotifyd_pid()), "name": DEVICE_NAME}))
    else:
        die("Usage: omarchyss-spotify device {setup|start|stop|status}", 2)


def cmd_logout(_args):
    stop_spotifyd()
    try:
        os.unlink(SPOTIFYD_CREDENTIAL_FILE)
    except FileNotFoundError:
        pass
    keyring_clear()
    config = load_config()
    config.pop("access_token", None)
    config.pop("access_token_expires_at", None)
    save_config(config)
    print("Logged out of Spotify.")


COMMANDS = {
    "setup": cmd_setup,
    "auth": cmd_auth,
    "status": cmd_status,
    "search": cmd_search,
    "devices": cmd_devices,
    "play": cmd_play,
    "transfer": cmd_transfer,
    "now-playing": cmd_now_playing,
    "control": cmd_control,
    "preferences": cmd_preferences,
    "device": cmd_device,
    "logout": cmd_logout,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die(f"Usage: omarchyss-spotify {{{'|'.join(COMMANDS)}}}", 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
