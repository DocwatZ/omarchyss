#!/usr/bin/env python3
"""Spotify Web API helper for OmarchySS.

Handles the one-time OAuth PKCE login, refresh-token storage (via the
system's libsecret keyring through `secret-tool`), catalog search, and
remote playback control. Kept separate from bin/omarchyss (the bash
screensaver/MPRIS script) since this talks to the network and needs
JSON/HTTP handling that's painful in bash.

Usage:
  omarchyss-spotify setup <client-id>   Store your Spotify app's Client ID
  omarchyss-spotify auth                One-time browser login (PKCE)
  omarchyss-spotify status              Print auth/config status as JSON
  omarchyss-spotify search <query>      Search tracks, print JSON array
  omarchyss-spotify play <uri>          Start playback of a track URI
  omarchyss-spotify devices             List available Spotify Connect devices
"""
import base64
import hashlib
import http.server
import json
import os
import secrets
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_DIR = os.path.expanduser("~/.config/omarchyss")
CONFIG_FILE = os.path.join(CONFIG_DIR, "spotify.json")
REDIRECT_PORT = 8945
REDIRECT_URI = f"http://127.0.0.1:{REDIRECT_PORT}/callback"
SCOPES = "user-read-playback-state user-modify-playback-state user-read-currently-playing"
KEYRING_SERVICE = "omarchyss"
KEYRING_KEY = "spotify-refresh-token"
API_BASE = "https://api.spotify.com/v1"
ACCOUNTS_BASE = "https://accounts.spotify.com"


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def load_config():
    if not os.path.isfile(CONFIG_FILE):
        return {}
    with open(CONFIG_FILE) as f:
        return json.load(f)


def save_config(config):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(config, f, indent=2)
    os.chmod(CONFIG_FILE, 0o600)


def keyring_store(refresh_token):
    subprocess.run(
        ["secret-tool", "store", "--label=OmarchySS Spotify refresh token",
         "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        input=refresh_token, text=True, check=True,
    )


def keyring_lookup():
    result = subprocess.run(
        ["secret-tool", "lookup", "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        capture_output=True, text=True,
    )
    token = result.stdout.strip()
    return token if result.returncode == 0 and token else None


def keyring_clear():
    subprocess.run(
        ["secret-tool", "clear", "service", KEYRING_SERVICE, "key", KEYRING_KEY],
        capture_output=True, text=True,
    )


def http_json(url, data=None, headers=None, method=None):
    headers = headers or {}
    body = None
    if data is not None:
        body = urllib.parse.urlencode(data).encode()
        headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
    req = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else {})
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            payload = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            payload = {"error": raw.decode(errors="replace")}
        return e.code, payload


def require_client_id(config):
    client_id = config.get("client_id")
    if not client_id:
        die("omarchyss-spotify: no Client ID configured. Run: omarchyss-spotify setup <client-id>")
    return client_id


def pkce_pair():
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    return verifier, challenge


def cmd_setup(args):
    if not args:
        die("Usage: omarchyss-spotify setup <client-id>")
    config = load_config()
    config["client_id"] = args[0]
    save_config(config)
    print(f"Stored Spotify Client ID. Now run: omarchyss-spotify auth")
    print(f"Make sure {REDIRECT_URI} is registered as a Redirect URI on your Spotify app.")


def cmd_auth(_args):
    config = load_config()
    client_id = require_client_id(config)
    verifier, challenge = pkce_pair()
    state = secrets.token_urlsafe(16)

    auth_params = {
        "client_id": client_id,
        "response_type": "code",
        "redirect_uri": REDIRECT_URI,
        "code_challenge_method": "S256",
        "code_challenge": challenge,
        "scope": SCOPES,
        "state": state,
    }
    auth_url = f"{ACCOUNTS_BASE}/authorize?{urllib.parse.urlencode(auth_params)}"

    received = {}
    event = threading.Event()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path != "/callback":
                self.send_response(404)
                self.end_headers()
                return
            query = urllib.parse.parse_qs(parsed.query)
            received["code"] = query.get("code", [None])[0]
            received["state"] = query.get("state", [None])[0]
            received["error"] = query.get("error", [None])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            ok = received.get("code") and not received.get("error")
            message = "You can close this tab and return to OmarchySS." if ok else "Spotify login failed. You can close this tab."
            self.wfile.write(f"<html><body style='font-family:sans-serif'><h2>{message}</h2></body></html>".encode())
            event.set()

    server = http.server.HTTPServer(("127.0.0.1", REDIRECT_PORT), Handler)
    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()

    opened = subprocess.run(["xdg-open", auth_url], capture_output=True)
    if opened.returncode != 0:
        print("Open this URL in a browser to log in to Spotify:")
        print(auth_url)

    print("Waiting for Spotify login in your browser...")
    if not event.wait(timeout=180):
        server.shutdown()
        die("Timed out waiting for Spotify login.")
    server.shutdown()

    if received.get("error") or not received.get("code"):
        die(f"Spotify login failed: {received.get('error', 'no code returned')}")
    if received.get("state") != state:
        die("Spotify login failed: state mismatch (possible CSRF).")

    status, payload = http_json(
        f"{ACCOUNTS_BASE}/api/token",
        data={
            "client_id": client_id,
            "grant_type": "authorization_code",
            "code": received["code"],
            "redirect_uri": REDIRECT_URI,
            "code_verifier": verifier,
        },
    )
    if status != 200 or "refresh_token" not in payload:
        die(f"Spotify token exchange failed: {payload}")

    keyring_store(payload["refresh_token"])
    config["access_token"] = payload["access_token"]
    config["access_token_expires_at"] = time.time() + payload.get("expires_in", 3600) - 30
    save_config(config)
    print("Spotify login complete. You're all set.")


def get_access_token(config):
    if config.get("access_token") and time.time() < config.get("access_token_expires_at", 0):
        return config["access_token"]

    client_id = require_client_id(config)
    refresh_token = keyring_lookup()
    if not refresh_token:
        die("omarchyss-spotify: not logged in. Run: omarchyss-spotify auth")

    status, payload = http_json(
        f"{ACCOUNTS_BASE}/api/token",
        data={
            "client_id": client_id,
            "grant_type": "refresh_token",
            "refresh_token": refresh_token,
        },
    )
    if status != 200 or "access_token" not in payload:
        die(f"omarchyss-spotify: token refresh failed ({status}): {payload}")

    config["access_token"] = payload["access_token"]
    config["access_token_expires_at"] = time.time() + payload.get("expires_in", 3600) - 30
    if payload.get("refresh_token"):
        keyring_store(payload["refresh_token"])
    save_config(config)
    return config["access_token"]


def api_request(config, path, method="GET", body=None):
    token = get_access_token(config)
    headers = {"Authorization": f"Bearer {token}"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(f"{API_BASE}{path}", data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read()
            return resp.status, (json.loads(raw) if raw else {})
    except urllib.error.HTTPError as e:
        raw = e.read()
        try:
            payload = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            payload = {"error": raw.decode(errors="replace")}
        return e.code, payload


def cmd_status(_args):
    config = load_config()
    print(json.dumps({
        "configured": bool(config.get("client_id")),
        "loggedIn": bool(keyring_lookup()),
    }))


def cmd_search(args):
    if not args:
        die("Usage: omarchyss-spotify search <query> [limit]")
    query = args[0]
    limit = args[1] if len(args) > 1 else "8"
    config = load_config()
    status, payload = api_request(
        config, f"/search?{urllib.parse.urlencode({'q': query, 'type': 'track', 'limit': limit})}"
    )
    if status != 200:
        die(f"omarchyss-spotify: search failed ({status}): {payload.get('error', payload)}")
    tracks = payload.get("tracks", {}).get("items", [])
    results = []
    for t in tracks:
        images = (t.get("album") or {}).get("images") or []
        image = images[-1]["url"] if images else ""
        results.append({
            "uri": t.get("uri", ""),
            "name": t.get("name", ""),
            "artists": ", ".join(a.get("name", "") for a in t.get("artists", [])),
            "album": (t.get("album") or {}).get("name", ""),
            "image": image,
        })
    print(json.dumps(results))


def cmd_devices(_args):
    config = load_config()
    status, payload = api_request(config, "/me/player/devices")
    if status != 200:
        die(f"omarchyss-spotify: devices failed ({status}): {payload.get('error', payload)}")
    print(json.dumps(payload.get("devices", [])))


def cmd_play(args):
    if not args:
        die("Usage: omarchyss-spotify play <uri> [device_id]")
    uri = args[0]
    config = load_config()
    device_id = args[1] if len(args) > 1 else None
    if not device_id:
        status, payload = api_request(config, "/me/player/devices")
        devices = payload.get("devices", []) if status == 200 else []
        active = next((d for d in devices if d.get("is_active")), None)
        device_id = (active or (devices[0] if devices else {})).get("id")
    path = "/me/player/play"
    if device_id:
        path += f"?{urllib.parse.urlencode({'device_id': device_id})}"
    status, payload = api_request(config, path, method="PUT", body={"uris": [uri]})
    if status not in (200, 204):
        die(f"omarchyss-spotify: play failed ({status}): {payload.get('error', payload)}\n"
            "(Remote play requires Spotify Premium and an active/open Spotify device.)")


def cmd_logout(_args):
    keyring_clear()
    config = load_config()
    config.pop("access_token", None)
    config.pop("access_token_expires_at", None)
    save_config(config)
    print("Logged out of Spotify.")


COMMANDS = {
    "setup": cmd_setup,
    "auth": cmd_auth,
    "status": cmd_status,
    "search": cmd_search,
    "devices": cmd_devices,
    "play": cmd_play,
    "logout": cmd_logout,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die(f"Usage: omarchyss-spotify {{{'|'.join(COMMANDS)}}}", 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
